"use client";

import { useMemo, useState } from "react";
import type { CSSProperties } from "react";

interface PortalBrandMarkProps {
  organizationName: string;
  logoSrc?: string | null;
  alt?: string;
  fallbackLabel?: string | null;
  className?: string;
  imageClassName?: string;
  labelClassName?: string;
  style?: CSSProperties;
  mode?: "sidebar" | "topbar";
}

function getInitials(value: string) {
  const parts = value
    .replace(/[^a-z0-9]+/gi, " ")
    .trim()
    .split(/\s+/)
    .filter(Boolean);
  if (!parts.length) {
    return "N";
  }
  if (parts.length === 1) {
    return parts[0].slice(0, 2).toUpperCase();
  }
  return `${parts[0][0]}${parts[1][0]}`.toUpperCase();
}

export function PortalBrandMark({
  organizationName,
  logoSrc,
  alt,
  fallbackLabel,
  className,
  imageClassName,
  labelClassName,
  style,
  mode = "sidebar",
}: PortalBrandMarkProps) {
  const [failedLogoSrc, setFailedLogoSrc] = useState<string | null>(null);

  const fallbackText = useMemo(() => fallbackLabel || getInitials(organizationName), [fallbackLabel, organizationName]);
  const showImage = Boolean(logoSrc) && failedLogoSrc !== logoSrc;
  const sidebarMode = mode === "sidebar";
  const sizeClass = sidebarMode ? "h-16 w-16" : "h-12 w-12";

  return (
    <div
      className={[
        "flex shrink-0 items-center justify-center overflow-hidden",
        sidebarMode ? "" : "rounded-2xl border border-[color:var(--border-subtle)] shadow-sm ring-1 ring-black/5 backdrop-blur",
        sizeClass,
        className || "",
      ].join(" ")}
      style={{
        backgroundColor: sidebarMode ? "transparent" : "var(--surface-panel-muted)",
        ...style,
      }}
    >
      {showImage ? (
        /* eslint-disable-next-line @next/next/no-img-element */
        <img
          src={logoSrc as string}
          alt={alt || organizationName}
          className={["h-full w-full object-contain", sidebarMode ? "p-0" : "p-1.5", imageClassName || ""].join(" ")}
          loading="eager"
          onError={() => setFailedLogoSrc(logoSrc || "__missing__")}
        />
      ) : (
        <div
          className={[
            "flex h-full w-full items-center justify-center text-[10px] font-black uppercase tracking-[0.28em] text-[color:var(--text-primary)]",
            sidebarMode ? "bg-transparent" : "bg-[color:var(--surface-panel)]",
            labelClassName || "",
          ].join(" ")}
        >
          {fallbackText}
        </div>
      )}
    </div>
  );
}
