"use client";

interface PowerBiEmbedProps {
  embedUrl: string | null;
  organizationName: string;
}

export function PowerBiEmbed({ embedUrl, organizationName }: PowerBiEmbedProps) {
  return (
    <section className="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl overflow-hidden shadow-xl ring-1 ring-black/5">
      <header className="px-8 py-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
          </div>
          <div>
            <h2 className="text-base font-bold text-slate-800 dark:text-slate-100">Analytics Insights</h2>
            <p className="text-xs text-slate-500 dark:text-slate-400">Power BI dashboard for {organizationName}</p>
          </div>
        </div>
        <div className="px-3 py-1 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 text-[10px] uppercase font-bold tracking-widest rounded-full border border-emerald-100 dark:border-emerald-800/50">
          Live Data
        </div>
      </header>

      <div className="p-1">
        {embedUrl ? (
          <div className="relative rounded-2xl overflow-hidden bg-slate-50 dark:bg-slate-950 min-h-[600px]">
            <iframe
              title="Power BI dashboard"
              src={embedUrl}
              loading="lazy"
              className="w-full h-[700px] border-0"
              allowFullScreen
            />
          </div>
        ) : (
          <div className="relative flex flex-col items-center justify-center py-24 text-center px-10 bg-slate-50 dark:bg-slate-950/20 rounded-2xl group overflow-hidden">
             <div className="absolute inset-0 bg-brand/5 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none" />
             <div className="w-20 h-20 bg-brand/5 dark:bg-brand/10 rounded-3xl flex items-center justify-center mx-auto mb-8 border border-brand/10 dark:border-brand/20 group-hover:scale-110 transition-transform duration-500">
               <svg className="w-10 h-10 text-brand opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
             </div>
             
             <div className="space-y-4 max-w-md relative z-10">
               <h3 className="text-xl font-black text-slate-900 dark:text-white tracking-tight uppercase">Operational Intelligence</h3>
               <p className="text-sm text-slate-500 dark:text-slate-400 font-medium leading-relaxed">
                  Advanced data visualization and terminal velocity insights are exclusive to organizations with 
                  <span className="text-brand font-bold mx-1">Standard</span> or <span className="text-brand font-bold mx-1">Pro</span> tiers.
               </p>
             </div>

             <div className="grid grid-cols-2 gap-3 pt-10 w-full max-w-sm relative z-10">
                <div className="p-5 rounded-2xl bg-white dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 shadow-sm">
                   <div className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Coverage</div>
                   <div className="text-lg font-black text-slate-200 dark:text-slate-700 tracking-tighter uppercase italic">LOCKED</div>
                </div>
                <div className="p-5 rounded-2xl bg-white dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 shadow-sm">
                   <div className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Drill-down</div>
                   <div className="text-lg font-black text-slate-200 dark:text-slate-700 tracking-tighter uppercase italic">SECURE</div>
                </div>
             </div>

             <div className="pt-10 relative z-10">
               <button className="px-8 py-3 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-black uppercase tracking-[0.2rem] hover:scale-105 active:scale-95 transition-all shadow-2xl shadow-slate-200 dark:shadow-none">
                  Request Dashboard Upgrade
               </button>
             </div>
          </div>
        )}
      </div>

      {!embedUrl && (
        <footer className="px-8 py-4 bg-slate-50/50 dark:bg-slate-900/50 border-t border-slate-100 dark:border-slate-800">
          <p className="text-[11px] text-slate-400 italic">
            Note: Analytics sync occurs every 15 minutes. Data may have a slight latency.
          </p>
        </footer>
      )}
    </section>
  );
}
