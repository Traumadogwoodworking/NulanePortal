"use client";

interface PageTitleProps {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}

export function PageTitle({ title, subtitle, eyebrow }: PageTitleProps) {
  return (
    <header className="space-y-2">
      {eyebrow && (
        <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500">
          {eyebrow}
        </p>
      )}
      <h1 className="text-[20px] font-bold text-blue-600 tracking-tight">
        {title}
      </h1>
      {subtitle && (
        <p className="text-[12px] text-blue-500">
          {subtitle}
        </p>
      )}
    </header>
  );
}
