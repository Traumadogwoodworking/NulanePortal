    <path d="M9 13h2v4H9z" stroke="currentColor" strokeWidth="1.8" fill="none" />
    <path d="M13 13h2v4h-2z" stroke="currentColor" strokeWidth="1.8" fill="none" />
  </svg>
);

const NotificationsIcon = () => (
  <svg viewBox="0 0 24 24" className="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M16 16v-4a4 4 0 0 0-8 0v4l-2 2h12l-2-2z"
      stroke="currentColor"
      strokeWidth="1.8"
      fill="none"
      strokeLinecap="round"
      strokeLinejoin="round"
    />
    <path d="M10 4h4v3H10z" stroke="currentColor" strokeWidth="1.8" fill="none" />
  </svg>
);

const TrainIcon = () => (
  <svg viewBox="0 0 24 24" className="w-5 h-5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none">
    <rect x="3" y="15" width="18" height="4" rx="1" stroke="currentColor" strokeWidth="1.5" />
    <path d="M5 15V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v9" stroke="currentColor" strokeWidth="1.5" />
    <path d="M5 10h14" stroke="currentColor" strokeWidth="1" opacity="0.4" />
    <path d="M9 4v11" stroke="currentColor" strokeWidth="1" opacity="0.4" />
    <path d="M15 4v11" stroke="currentColor" strokeWidth="1" opacity="0.4" />
    <circle cx="7" cy="17" r="1" fill="currentColor" />
    <circle cx="17" cy="17" r="1" fill="currentColor" />
    <path d="M2 20h20" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" opacity="0.2" />
  </svg>
);

const PaletteIcon = () => (
  <svg viewBox="0 0 24 24" className="w-5 h-5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none">
    <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
    <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
    <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
    <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
    <path
      d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.6-.7 1.6-1.6 0-.4-.2-.8-.5-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.6 1.6-1.6H16c3.3 0 6-2.7 6-6 0-4.4-4.5-8-10-8Z"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
    />
  </svg>
);

const LogoutIcon = () => (
  <svg viewBox="0 0 24 24" className="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
    <polyline points="16 17 21 12 16 7" />
    <line x1="21" y1="12" x2="9" y2="12" />
  </svg>
);

const RobotIcon = () => (
  <svg viewBox="0 0 24 24" className="w-5 h-5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none">
    <rect x="5" y="8" width="14" height="10" rx="2" stroke="currentColor" strokeWidth="1.5" />
    <circle cx="8.5" cy="12" r="1" fill="currentColor" />
    <circle cx="15.5" cy="12" r="1" fill="currentColor" />
    <path d="M12 8V6m0 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" />
    <path d="M9 18v2m6-2v2" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" />
  </svg>
);

const SupportIcon = () => (
  <svg viewBox="0 0 24 24" className="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" />
    <path d="M12 8v4M12 16h.01" stroke="currentColor" strokeWidth="2" strokeLinecap="round" />
  </svg>
);

const PenIcon = () => (
  <svg viewBox="0 0 24 24" className="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none">
    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" />
    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" />
  </svg>
);

export function PortalSidebar() {
  const pathname = usePathname();
  const safePathname = pathname ?? "/";
  const { session, user, isAdmin, isOrgAdmin, isSuperAdmin, isPortalAccessAllowed, isAwct, hasPermission, logout } = usePortalSession();

  const branding = useMemo(() => (session ? getPortalBranding(session) : null), [session]);
  const appBranding = useMemo(() => getAppBranding(safePathname), [safePathname]);
  
  const activeLogo = branding?.logoUrl || appBranding.brandLogo;
  const activeColor = appBranding.brandColor || "#ffffff";
  const isAppView = !!activeLogo;

  const accessInfo = useMemo(
    () => ({ isAdmin, isOrgAdmin, isSuperAdmin, isPortalAccessAllowed, isAwct, hasPermission }),
    [isAdmin, isOrgAdmin, isSuperAdmin, isPortalAccessAllowed, isAwct, hasPermission]
  );

  const visibleSections = useMemo(
    () => filterNavSectionsByAccess(navSections, accessInfo),
    [accessInfo]
  );

  const sanitizedUserDisplayName = useMemo(() => {
    const name = user?.display_name?.trim();
    if (!name) return null;
    return name;
  }, [user?.display_name]);
  const identityLabel = branding?.organizationName || session?.organization?.name || sanitizedUserDisplayName || user?.email || "Authorized Operator";

  return (
    <aside id="sidebar" className="border-r border-slate-200 bg-white transition-all duration-300">
        <div 
          id="sidebar-header" 
          className={`flex flex-col items-center justify-center px-4 py-10 border-b border-slate-200 overflow-hidden relative group transition-colors duration-500`}
          style={{ backgroundColor: activeColor }}
        >
        <div className="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
        <div className="relative z-10 transition-transform hover:scale-105 duration-500 flex items-center justify-center w-full">
          {activeLogo ? (
            <div className={`p-6 transition-all w-full flex items-center justify-center ${(!isAppView || activeLogo?.endsWith('.png')) ? 'bg-white/90 backdrop-blur-md rounded-[2.5rem] shadow-xl p-6 ring-1 ring-white/20' : ''}`}>
               <Image
                src={activeLogo}
                alt={appBranding.appLabel || branding?.organizationName || "Portal"}
                width={200}
                height={80}
                className="object-contain opacity-100"
                style={{ height: 'auto', maxWidth: '100%' }}
                priority
              />
            </div>
          ) : (
            <div className="w-20 h-20 rounded-[2.5rem] bg-brand flex items-center justify-center text-white font-black text-4xl shadow-[0_0_50px_var(--brand-light)] animate-pulse border-2 border-white/20">
              {appBranding.appLabel?.[0] || branding?.organizationName?.[0] || "N"}
            </div>
          )}
        </div>
        {isAppView && (
          <div className="absolute bottom-2 left-0 right-0 flex justify-center">
             <span className="text-[8px] font-black uppercase tracking-[0.3em] text-white/40">{appBranding.appLabel}</span>
          </div>
        )}
      </div>

      <div id="sidebar-content" className="flex-1 overflow-y-auto px-2 space-y-5 py-2 custom-scrollbar">
        <div className="sidebar-nav space-y-4">
          {visibleSections.map((section) => (
            <div key={section.key} className="nav-section-container">
              <div className="px-3 mb-2 text-[10px] font-black uppercase tracking-[0.25em] text-slate-400/80">
                {section.title}
              </div>
              <div className="flex flex-col gap-1 divide-y divide-slate-50">
                {section.items.map((item) => {
                  const active = isActive(safePathname, item.href);
                  
                  return (
                    <Link
                      key={item.href}
                      href={item.href}
                      className={`nav-link group relative flex items-center gap-3 px-3 py-3 transition-all duration-200 ${
                        active 
                          ? "border-slate-100 ring-1 ring-slate-200 shadow-sm transform scale-[1.01] z-10" 
                          : "bg-white border-transparent hover:bg-slate-50"
                      }`}
                      style={active ? { backgroundColor: `${activeColor}15` } : {}}
                    >
                      {active && (
                        <div 
                          className="absolute left-0 top-2 bottom-2 w-0.5 rounded-r-full shadow-sm" 
                          style={{ backgroundColor: activeColor }}
                        />
                      )}
                      
                      <div className={`nav-link-icon flex items-center justify-center transition-all duration-300 ${
                        active ? "scale-105" : "group-hover:text-slate-500"
                      }`} style={active ? { color: activeColor } : {}}>
                        {item.icon === "dashboard" && <DashboardIcon />}
                        {item.icon === "home" && <HomeIcon />}
                        {item.icon === "reports" && <ReportsIcon />}
                        {item.icon === "people" && <PeopleIcon />}
                        {item.icon === "shield" && <ShieldIcon />}
                        {item.icon === "facility" && <FacilityIcon />}
                        {item.icon === "notifications" && <NotificationsIcon />}
                        {item.icon === "palette" && <PaletteIcon />}
                        {item.icon === "rsa" && <TrainIcon />}
                        {item.icon === "support" && <SupportIcon />}
                        {item.icon === "robot" && <RobotIcon />}
                        {item.icon === "pen" && <PenIcon />}
                        
                        {(item.icon?.startsWith("/") || item.icon?.startsWith("http")) && (
                          <div className={`w-7 h-7 rounded-md p-1.5 overflow-hidden flex items-center justify-center transition-all ${
                            active 
                              ? "bg-brand/20 ring-1 ring-brand/40" 
                              : "bg-slate-100 group-hover:bg-slate-200"
                          }`}>
                            <Image 
                              src={item.icon} 
                              alt={item.label} 
                              width={20} 
                              height={20} 
                              className={`object-contain transition-all duration-300 opacity-100`} 
                            />
                          </div>
                        )}
                        {!(item.icon?.startsWith("/") || item.icon?.startsWith("http")) &&
                          !["dashboard", "reports", "people", "shield", "facility", "notifications", "palette", "rsa", "support", "robot", "pen", "docufit"].includes(item.icon ?? "") && (
                            <span className="icon-emoji text-lg">{item.icon}</span>
                          )}
                      </div>

                      <div className="flex flex-col flex-1 min-w-0 pr-2">
                        <span className="text-[12px] font-bold truncate leading-tight text-slate-800">
                          {item.label}
                        </span>
                        {!active && (
                          <span className="text-[9px] text-slate-500 font-bold uppercase tracking-tight truncate leading-tight mt-0.5 group-hover:text-slate-700">
                            {item.description}
                          </span>
                        )}
                      </div>

                      {item.badge && (
                        <span className={`px-1.5 py-0.5 rounded text-[8px] font-black uppercase tracking-widest ${
                          item.badge === 'Live' 
                            ? 'bg-red-500/10 text-red-500 ring-1 ring-red-500/20' 
                            : 'bg-slate-100 text-slate-500'
                        }`}>
                          {item.badge}
                        </span>
                      )}
                    </Link>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div className="sidebar-footer p-4 flex flex-col gap-4 bg-transparent mt-4">
         <div className="flex justify-center group transition-all relative">
          <div className="w-full flex-shrink-0 opacity-100 relative z-10 transition-transform group-hover:scale-105 duration-700 p-0 flex items-center justify-center">
                <Image
                src="/media/powered_by_colorful.png"
                alt="N"
                width={300}
                height={300}
                className={`transition-all object-contain w-full h-auto p-2 ${isAppView ? 'brightness-0 opacity-50 dark:invert' : ''}`}
                priority
              />
          </div>
          <div className="absolute bottom-[110%] left-1/2 -translate-x-1/2 px-4 py-2.5 bg-gradient-to-br from-brand to-brand-accent text-white text-[11px] font-black rounded-[1.25rem] opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 origin-bottom transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 pointer-events-none whitespace-nowrap shadow-[0_15px_40px_-5px_rgba(37,99,235,0.45)] z-50 flex items-center gap-2.5 border border-white/20 backdrop-blur-sm">
            <div className="w-2 h-2 rounded-full bg-white shadow-[0_0_10px_#fff] animate-pulse" />
            <span className="tracking-tight">{identityLabel}</span>
            <div className="absolute top-[95%] left-1/2 -translate-x-1/2 border-[10px] border-transparent border-t-brand"></div>
          </div>
        </div>

        <button
          onClick={() => logout()}
          className="flex items-center justify-center gap-3 w-full px-3 py-3 rounded-xl border-2 border-slate-100 text-[11px] font-black uppercase tracking-widest text-slate-500 hover:text-red-500 hover:border-red-200 hover:bg-red-50 transition-all group"
        >
          <div className="w-6 h-6 flex items-center justify-center transition-all">
            <LogoutIcon />
          </div>
          <span>Sign Out</span>
        </button>
      </div>
    </aside>
  );
}
