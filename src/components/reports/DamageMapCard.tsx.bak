"use client";

import { normalizeMediaUrl } from "@/lib/config";
import type { ReportDamageApiRow, ReportDamageEntry } from "@/lib/types";
import { StatusBadge } from "@/components/ui/StatusBadge";
import { severityLabel, severityPriority, severityTone } from "@/lib/severityUtils";

const REGION_CONFIG = [
  { key: "front", label: "Front", keywords: ["front", "nose", "bumper", "hood", "grill"] },
  { key: "rear", label: "Rear", keywords: ["rear", "back", "tail", "trunk"] },
  { key: "left", label: "Left", keywords: ["left", "driver", "port", "side"] },
  { key: "right", label: "Right", keywords: ["right", "passenger", "starboard", "side"] },
  { key: "roof", label: "Roof", keywords: ["roof", "top", "canopy"] },
];

const LEGEND_ITEMS = [
  { label: "High", tone: "danger" as const },
  { label: "Medium", tone: "warning" as const },
  { label: "Low", tone: "positive" as const },
];

type RegionSummary = {
  entries: ReportDamageEntry[];
  highestSeverity: string;
};

function determineRegion(entry: ReportDamageEntry): string {
  const area = (entry.damage_area ?? "").toString().toLowerCase();
  for (const region of REGION_CONFIG) {
    for (const keyword of region.keywords) {
      if (keyword && area.includes(keyword)) {
        return region.key;
      }
    }
  }
  return "general";
}

function buildRegionSummaries(entries: ReportDamageEntry[]): Record<string, RegionSummary> {
  const summaries: Record<string, RegionSummary> = {};
  entries.forEach((entry) => {
    const regionKey = determineRegion(entry);
    const bucket = summaries[regionKey] ?? { entries: [], highestSeverity: "unknown" };
    bucket.entries.push(entry);
    const currentPriority = severityPriority(bucket.highestSeverity);
    const candidatePriority = severityPriority(entry.severity);
    if (candidatePriority >= currentPriority) {
      bucket.highestSeverity = severityLabel(entry.severity);
    }
    summaries[regionKey] = bucket;
  });
  return summaries;
}

export function DamageMapCard({ report }: { report?: ReportDamageApiRow | null }) {
  const entries = report?.damage_entries ?? [];
  const summaries = buildRegionSummaries(entries);
  const locationName =
    report?.location?.location_label ||
    report?.location?.location_name ||
    report?.location?.facility ||
    "Global facility";
  const splatUrl = report?.splat_urls?.[0] ? normalizeMediaUrl(report.splat_urls[0]) : null;
  const hasSplat = Boolean(splatUrl);
  const metadataSource =
    (typeof report?.overview?.metadata === "object" && report?.overview?.metadata) ||
    (typeof report?.metadata === "object" && report?.metadata) ||
    null;
  const metadataEntries = metadataSource
    ? Object.entries(metadataSource)
        .filter(([, value]) => value !== undefined && value !== null)
        .slice(0, 6)
    : [];
  const hasAnyDamage = entries.length > 0;

  return (
    <div className="rounded-3xl border border-slate-200/60 dark:border-slate-800/60 bg-white dark:bg-slate-950/60 shadow-lg overflow-hidden">
      <div className="p-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40">
        <div className="flex flex-col gap-2">
          <div className="flex items-center justify-between gap-2">
            <div>
              <p className="text-[10px] font-black uppercase tracking-[0.3em] text-slate-500">Damage map</p>
              <p className="text-lg font-black text-slate-900 dark:text-white tracking-tight">Region-based overview</p>
            </div>
            <span className="text-[8px] font-black uppercase tracking-[0.4em] text-slate-500">Live</span>
          </div>
          <p className="text-[11px] font-bold uppercase tracking-[0.3em] text-slate-400">
            {locationName}
            {report?.location?.location_id ? ` · ${report.location.location_id}` : ""}
          </p>
          {report?.overview?.navigationText && (
            <p className="text-[10px] text-slate-500">{report.overview.navigationText}</p>
          )}
        </div>
      </div>
      <div className="grid gap-4 p-4 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <div className="space-y-3">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {REGION_CONFIG.map((region) => {
              const summary = summaries[region.key];
              const count = summary?.entries.length ?? 0;
              const severity = summary?.highestSeverity;
              const tone = severityTone(summary?.highestSeverity);
              return (
                <div
                  key={region.key}
                  className={`rounded-2xl border p-3 transition-all ${
                    count > 0
                      ? "border-brand/30 bg-brand/5"
                      : "border-slate-200 dark:border-slate-800 bg-transparent"
                  }`}
                >
                  <div className="flex items-center justify-between gap-2 mb-2">
                    <p className="text-[11px] font-black uppercase tracking-[0.3em] text-slate-500">{region.label}</p>
                    {count > 0 && (
                      <StatusBadge label={`${count} issue${count > 1 ? "s" : ""}`} tone={tone} />
                    )}
                  </div>
                  {count > 0 ? (
                    <div className="space-y-1 text-[12px] text-slate-500">
                      <p className="text-[10px] uppercase tracking-tight text-slate-400">Severity</p>
                      <p className="text-sm font-black text-slate-900 dark:text-white capitalize">{severity}</p>
                    </div>
                  ) : (
                    <p className="text-[11px] uppercase tracking-[0.3em] text-slate-400">No recorded incidents</p>
                  )}
                </div>
              );
            })}
          </div>
          {summaries.general && (
            <div className="rounded-2xl border border-slate-200 dark:border-slate-800 p-3 bg-slate-50/40 dark:bg-slate-900/30">
              <p className="text-[11px] font-black uppercase tracking-[0.3em] text-slate-500">Other regions</p>
              <div className="mt-2 text-[12px] text-slate-600 dark:text-slate-300 space-y-1">
                <p className="font-semibold">{summaries.general.entries.length} additional event(s)</p>
                <p className="text-[10px] text-slate-400">Captured incidents with unspecified locations.</p>
              </div>
            </div>
          )}
          {!hasAnyDamage && (
            <div className="rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 px-4 py-6 text-center text-[10px] font-black uppercase tracking-[0.4em] text-slate-400">
              No damage recorded
            </div>
          )}
        </div>

        <div className="space-y-4">
          {hasSplat ? (
            <div className="rounded-3xl border border-slate-200 dark:border-slate-800 overflow-hidden bg-slate-50">
              <img src={splatUrl!} alt="Surface splat chart" className="w-full h-72 object-cover" />
              <div className="p-4">
                <p className="text-[10px] font-black uppercase tracking-[0.4em] text-slate-400 mb-1">Surface snapshot</p>
                <p className="text-sm font-black text-slate-900 dark:text-white">Impact distribution (normalized)</p>
                <p className="text-[11px] text-slate-500">Tap-to-expand for a closer view</p>
              </div>
            </div>
          ) : (
            <div className="rounded-3xl border border-dashed border-slate-200 dark:border-slate-800 px-4 py-6 text-center text-[11px] font-black uppercase tracking-[0.3em] text-slate-400">
              Surface splat unavailable
            </div>
          )}

          <div className="rounded-3xl border border-slate-100 bg-white dark:bg-slate-900/40 p-4 shadow-sm">
            <h4 className="text-[9px] font-black uppercase tracking-[0.4em] text-slate-500 mb-3">Location metadata</h4>
            {metadataEntries.length === 0 ? (
              <p className="text-[11px] text-slate-500">No additional metadata provided.</p>
            ) : (
              <dl className="grid grid-cols-2 gap-3 text-[11px]">
                {metadataEntries.map(([key, value]) => (
                  <div key={key}>
                    <dt className="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">{key}</dt>
                    <dd className="text-sm font-semibold text-slate-900 dark:text-white">{String(value)}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
      </div>
      <div className="px-4 pb-4 pt-2">
        <div className="flex flex-wrap items-center gap-3 text-[9px] uppercase tracking-[0.4em] text-slate-500">
          {LEGEND_ITEMS.map((item) => (
            <div key={item.label} className="flex items-center gap-1">
              <span
                className={`w-2 h-2 rounded-full ${
                  item.tone === "danger"
                    ? "bg-rose-500"
                    : item.tone === "warning"
                    ? "bg-amber-500"
                    : "bg-emerald-500"
                }`}
              />
              {item.label}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
