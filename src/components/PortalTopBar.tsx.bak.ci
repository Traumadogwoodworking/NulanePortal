"use client";

import Link from "next/link";
import Image from "next/image";
import { usePathname } from "next/navigation";
import { usePortalSession } from "@/lib/portalSession";
import { getPortalBranding, getAppBranding } from "@/lib/branding";
import { useState, useMemo, useCallback } from "react";
import { CircleGauge, Moon, Sun } from "lucide-react";
import { usePortalThemeMode } from "@/lib/portalTheme";

interface PortalTopBarProps {
  pageTitle: string;
  pageSubtitle?: string;
}

const ThemeToggle = () => {
  const { mode, cycleThemeMode } = usePortalThemeMode();
  const handleToggle = useCallback(() => cycleThemeMode(), [cycleThemeMode]);
  const thumbTranslate = mode === "branded" ? "translateX(0px)" : mode === "dark" ? "translateX(36px)" : "translateX(72px)";
  return (
    <button
      type="button"
      onClick={handleToggle}
      aria-pressed={mode !== "branded"}
      className="relative h-10 w-[9.5rem] rounded-full border border-white/20 bg-slate-900/80 text-yellow-200 shadow-[0_20px_60px_rgba(0,0,0,0.35)] transition-all hover:border-white/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
    >
      <span className="absolute inset-0 rounded-full bg-gradient-to-r from-black via-slate-900 to-slate-800 opacity-90" />
      <div className="relative z-10 flex h-full items-center justify-between px-3 text-[9px] font-black uppercase tracking-[0.24em] text-slate-200">
        <span className={mode === "branded" ? "text-cyan-200" : "text-slate-400"}>Brand</span>
        <span className={mode === "dark" ? "text-cyan-200" : "text-slate-400"}>Dark</span>
        <span className={mode === "light" ? "text-cyan-200" : "text-slate-400"}>Light</span>
      </div>
      <span
        className="absolute left-1 top-1 bottom-1 w-[2.6rem] rounded-full bg-cyan-300 shadow-[0_15px_40px_rgba(34,211,238,0.35)] transition-transform"
        style={{ transform: thumbTranslate }}
      />
    </button>
  );
};

export function PortalTopBar({ pageTitle, pageSubtitle }: PortalTopBarProps) {
  const pathname = usePathname();
  const safePathname = pathname ?? "/";
  const { user, logout, session } = usePortalSession();
  const [profileOpen, setProfileOpen] = useState(false);

  const branding = session ? getPortalBranding(session) : null;
  const appBranding = useMemo(() => getAppBranding(safePathname), [safePathname]);
  
  const activeColor = branding?.logoUrl ? "var(--brand)" : appBranding.brandColor || "var(--brand)";
  const profileName =
    user?.display_name?.trim() || user?.email?.split("@")[0] || "Account";
  const organizationName =
    branding?.organizationName ?? session?.organization?.name ?? "Portal";
  const logoSrc = branding?.logoUrl || appBranding.brandLogo || null;

  return (
    <header className="portal-top-bar sticky top-0 z-40 w-full border-b border-slate-200/50 bg-white/90 backdrop-blur-md">
      <div className="flex w-full items-center justify-between gap-6 px-6 py-3 max-w-[1580px] mx-auto">
        <div className="flex items-center gap-3 min-w-[200px]">
          <div className="flex h-12 w-12 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            {logoSrc ? (
              <Image src={logoSrc} alt={organizationName} width={44} height={44} className="h-full w-full object-contain p-1.5" />
            ) : (
              <CircleGauge className="h-5 w-5 text-slate-500" />
            )}
          </div>
          <div className="relative">
            <button
              onClick={() => setProfileOpen((prev) => !prev)}
              className="portal-account-pill group flex items-center gap-3 rounded-full border border-slate-100 bg-white px-3 py-1.5 text-left shadow-sm transition hover:border-brand"
              aria-expanded={profileOpen}
            >
              <div
                className="flex h-10 w-10 items-center justify-center rounded-2xl text-white"
                style={{ backgroundColor: activeColor }}
              >
                {profileName.charAt(0).toUpperCase()}
              </div>
              <div className="flex flex-col text-sm leading-none">
                <span className="font-black text-slate-900">{profileName}</span>
                <span className="text-[9px] uppercase tracking-[0.2em] text-slate-400">{user?.role || "Member"}</span>
              </div>
            </button>
            {profileOpen && (
              <>
                <div className="fixed inset-0 z-20" onClick={() => setProfileOpen(false)}></div>
                <div className="absolute left-0 top-full mt-3 w-64 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl">
                  <div className="space-y-1 border-b border-slate-100 pb-3">
                    <p className="text-[8px] uppercase tracking-[0.4em] text-slate-400">Identity Context</p>
                    <p className="text-sm font-black text-slate-900">{profileName}</p>
                    <p className="text-xs text-slate-500">{user?.email}</p>
                  </div>
                  <div className="space-y-1 pt-3">
                    <Link
                      href="/settings"
                      onClick={() => setProfileOpen(false)}
                      className="flex items-center justify-between rounded-xl border border-slate-100 px-3 py-2 text-sm font-bold text-slate-600 hover:bg-slate-50"
                    >
                      Account Parameters
                      <span className="text-xs uppercase tracking-[0.2em] text-slate-400">Go</span>
                    </Link>
                    <button
                      onClick={() => {
                        setProfileOpen(false);
                        logout();
                      }}
                      className="w-full rounded-xl border border-rose-200 px-3 py-2 text-sm font-bold text-rose-500 hover:bg-rose-50"
                    >
                      Terminate Session
                    </button>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>

        <div className="flex flex-col items-center text-center gap-1">
          <p className="text-[9px] uppercase tracking-[0.35em] text-slate-400">{pageSubtitle || "Command Center"}</p>
          <h1 className="text-sm font-black uppercase tracking-[0.35em] text-slate-900">{pageTitle}</h1>
          <p className="text-[10px] uppercase tracking-[0.4em] text-slate-400">{organizationName}</p>
        </div>

        <div className="flex items-center gap-4">
          <div className="text-right">
          <p className="text-[12px] font-black uppercase tracking-[0.3em] text-slate-800">{organizationName}</p>
            <p className="text-[9px] uppercase tracking-[0.4em] text-slate-400">Trusted Asset Registry</p>
          </div>
          <ThemeToggle />
        </div>
      </div>
    </header>
  );
}
