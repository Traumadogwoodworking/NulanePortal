"use client";

import Link from "next/link";
import { usePortalSession } from "@/lib/portalSession";
import { getPortalBranding } from "@/lib/branding";
import { useState, useMemo } from "react";
import { Moon, Sun, Sparkles, ChevronDown } from "lucide-react";
import { usePortalThemeMode } from "@/lib/portalTheme";
import { usePortalBrandingSnapshot } from "@/lib/portalData";
import type { PortalSessionResponse } from "@/lib/types";

interface PortalTopBarProps {
  pageTitle: string;
  pageSubtitle?: string;
}

const ThemeToggle = () => {
  const { mode, setMode } = usePortalThemeMode();
  return (
    <div className="flex items-center gap-1 rounded-full border border-slate-200 bg-white/90 p-1 shadow-sm">
      {[
        { key: "branded", label: "Brand", icon: Sparkles },
        { key: "dark", label: "Dark", icon: Moon },
        { key: "light", label: "Light", icon: Sun },
      ].map((item) => {
        const Icon = item.icon;
        const active = mode === item.key;
        return (
          <button
            key={item.key}
            type="button"
            onClick={() => setMode(item.key as typeof mode)}
            className={`inline-flex items-center gap-1.5 rounded-full px-3 py-2 text-[10px] font-black uppercase tracking-[0.22em] transition ${
              active ? "bg-slate-900 text-white shadow-sm" : "text-[color:var(--text-secondary)] hover:bg-slate-100 hover:text-[color:var(--text-primary)]"
            }`}
          >
            <Icon className="h-3.5 w-3.5" />
            {item.label}
          </button>
        );
      })}
    </div>
  );
};

export function PortalTopBar({ pageTitle, pageSubtitle }: PortalTopBarProps) {
  const { user, logout, session } = usePortalSession();
  const [profileOpen, setProfileOpen] = useState(false);
  const { data: brandingSnapshot } = usePortalBrandingSnapshot();

  const branding = useMemo(() => {
    if (!session) {
      return brandingSnapshot
        ? getPortalBranding({ branding_snapshot: brandingSnapshot } as PortalSessionResponse)
        : null;
    }
    if (brandingSnapshot) {
      return getPortalBranding({ ...session, branding_snapshot: brandingSnapshot } as PortalSessionResponse);
    }
    return getPortalBranding(session);
  }, [brandingSnapshot, session]);
  const organizationName = branding?.organizationName ?? session?.organization?.name ?? "Portal";
  
  const userDisplayName = useMemo(() => {
    if (user?.display_name) {
      return user.display_name;
    }
    if (user?.first_name && user?.last_name) {
      return `${user.first_name} ${user.last_name}`;
    }
    if (user?.email) {
      return user.email;
    }
    return "User";
  }, [user]);

  const profileInitial = useMemo(() => {
    const nameToUse = userDisplayName !== "User" ? userDisplayName : (user?.email || "A");
    return nameToUse.trim().slice(0, 1).toUpperCase();
  }, [userDisplayName, user]);

  return (
    <header className="portal-top-bar sticky top-0 z-40 w-full border-b border-slate-200/60 bg-white/92 backdrop-blur-md">
      <div className="mx-auto flex w-full max-w-[1580px] items-center justify-between gap-6 px-6 py-3">
        <div className="flex min-w-[260px] items-center gap-3">
          <div className="relative">
            <button
              onClick={() => setProfileOpen((prev) => !prev)}
              className="group flex items-center gap-3 rounded-full border border-slate-200 bg-white px-4 py-1.5 text-left shadow-sm transition hover:border-slate-300"
              aria-expanded={profileOpen}
              aria-label="Account menu"
            >
              <div className="flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-[10px] font-black uppercase tracking-[0.2em] text-white">
                {profileInitial}
              </div>
              <div className="flex flex-col">
                <span className="text-xs font-bold text-slate-700">{userDisplayName}</span>
              </div>
              <ChevronDown className="h-4 w-4 text-slate-400" />
            </button>
            {profileOpen && (
              <>
                <div className="fixed inset-0 z-20" onClick={() => setProfileOpen(false)}></div>
                <div className="absolute left-0 top-full mt-3 w-64 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl">
                  <div className="space-y-2 border-b border-slate-100 pb-3">
                    <p className="text-[8px] uppercase tracking-[0.4em] text-[color:var(--text-secondary)]">Account</p>
                    <p className="text-sm font-black text-[color:var(--text-primary)]">Signed in</p>
                    <p className="text-xs text-[color:var(--text-secondary)]">{organizationName}</p>
                  </div>
                  <div className="space-y-1 pt-3">
                    <Link
                      href="/settings"
                      onClick={() => setProfileOpen(false)}
                      className="flex items-center justify-between rounded-xl border border-slate-100 px-3 py-2 text-sm font-bold text-[color:var(--text-primary)]/80 hover:bg-slate-50"
                    >
                      Account Parameters
                      <span className="text-xs uppercase tracking-[0.2em] text-slate-400">Go</span>
                    </Link>
                    <button
                      onClick={() => {
                        setProfileOpen(false);
                        logout();
                      }}
                      className="w-full rounded-xl border border-rose-200 px-3 py-2 text-sm font-bold text-rose-600 hover:bg-rose-50"
                    >
                      Terminate Session
                    </button>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>

        <div className="flex min-w-0 flex-col items-center gap-1 text-center">
          <p className="text-[9px] uppercase tracking-[0.35em] text-[color:var(--text-secondary)]">{pageSubtitle || "Command Center"}</p>
          <h1 className="truncate text-sm font-black uppercase tracking-[0.35em] text-[color:var(--text-primary)]">{pageTitle}</h1>
        </div>

        <div className="flex items-center gap-4">

        </div>
      </div>
    </header>
  );
}
