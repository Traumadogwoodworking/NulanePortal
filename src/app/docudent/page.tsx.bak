"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { History } from "lucide-react";
import { ModuleNotice } from "@/components/ui/ModuleNotice";
import { Card, CardHeader, CardContent } from "@/components/ui/Card";
import { EmptyState } from "@/components/ui/EmptyState";
import { ErrorPanel } from "@/components/ui/ErrorPanel";
import { StatCard } from "@/components/ui/StatCard";
import { StatusBadge } from "@/components/ui/StatusBadge";
import { FileUploadPanel } from "@/components/docudent/FileUploadPanel";
import { hasOrganizationScope, isModuleEnabled } from "@/lib/modules";
import { usePortalSession } from "@/lib/portalSession";
import { ReportsAdapter } from "@/lib/services/reportService";
import type { ReportDamageApiRow } from "@/lib/types";
import {
  docuDentSteps,
  DocuDentDamageArea,
  DocuDentDamageType,
  DocuDentSeverity,
  DocuDentFormState,
  requiredFieldsByStep,
  reviewLabels,
} from "@/lib/docudent/schema";
import {
  DAMAGE_AREAS,
  DAMAGE_SEVERITIES,
  getDamageTypeOptionsForArea,
} from "@/lib/docudent/damageTaxonomy";
import { submitInspection, deriveReportId } from "@/lib/docudent/submitInspection";
import { uploadAttachments, type UploadSummary } from "@/lib/docudent/uploadAttachments";
import { PersistenceService, type StashedReport } from "@/lib/docudent/persistenceService";
import { RefreshCw } from "lucide-react";


export default function DocuDentPage() {
  const moduleEnabled = isModuleEnabled("docudent");
  const { session, organizationId } = usePortalSession();
  const hasScope = hasOrganizationScope(session);
  const [reports, setReports] = useState<ReportDamageApiRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [currentStep, setCurrentStep] = useState(0);
  const [formState, setFormState] = useState<DocuDentFormState>({
    vin: "",
    manualIdentifier: "",
    damageArea: "",
    damageType: "",
    severity: "",
    notes: "",
  });
  const [files, setFiles] = useState<File[]>([]);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submissionState, setSubmissionState] = useState<{
    status: "idle" | "success" | "error";
    message?: string;
    reportId?: string;
    attachments?: UploadSummary;
  }>({ status: "idle" });
  const [stashedReports, setStashedReports] = useState<StashedReport[]>([]);

  const loadData = useCallback(async () => {
    if (!organizationId || !moduleEnabled) return;
    setLoading(true);
    setLoadError(null);
    try {
      const res = await ReportsAdapter.fetchDamageReports({ organization_id: organizationId });
      setReports(res);
    } catch (err) {
      console.error("DocuDent reports fetch failed", err);
      setLoadError(err instanceof Error ? err.message : "Unable to load recent inspections.");
    } finally {
      setLoading(false);
    }
  }, [organizationId, moduleEnabled]);

  useEffect(() => {
    loadData();
    const draft = PersistenceService.loadDraft();
    if (draft && JSON.stringify(draft) !== JSON.stringify(formState)) {
      if (window.confirm("An unfinished inspection draft was found. Would you like to restore it?")) {
        setFormState(draft);
      } else {
        PersistenceService.clearDraft();
      }
    }
    setStashedReports(PersistenceService.listStashed());
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [loadData]);

  useEffect(() => {
    if (currentStep > 0 && submissionState.status !== "success") {
      PersistenceService.saveDraft(formState);
    }
  }, [formState, currentStep, submissionState.status]);

  const stats = useMemo(() => {
    const total = reports.length;
    const pending = reports.filter((r) => r.status === "review" || r.status === "open").length;
    return { total, pending };
  }, [reports]);

  const selectedAreaOption = useMemo(
    () => DAMAGE_AREAS.find((area) => area.code === formState.damageArea) ?? null,
    [formState.damageArea],
  );
  const damageTypeOptions = useMemo(
    () => getDamageTypeOptionsForArea(formState.damageArea),
    [formState.damageArea],
  );
  const selectedTypeOption = useMemo(
    () => damageTypeOptions.find((type) => type.code === formState.damageType) ?? null,
    [damageTypeOptions, formState.damageType],
  );

  const fieldError = useMemo(() => {
    const errors: Partial<Record<string, string>> = {};
    if (!formState.vin.trim() && !formState.manualIdentifier.trim()) {
      errors.vehicle = "Enter a VIN or manual identifier.";
    }
    if (!formState.damageArea) {
      errors.area = "Select the affected area.";
    }
    if (!formState.damageType) {
      errors.type = "Choose the damage type.";
    }
    if (!formState.severity) {
      errors.severity = "Set a severity level.";
    }
    if (!formState.notes.trim()) {
      errors.notes = "Add inspection notes.";
    }
    const requiresAttachment = requiredFieldsByStep.files?.length !== 0;
    if (requiresAttachment && !files.length) {
      errors.files = "Attach at least one file.";
    }
    return errors;
  }, [formState, files]);

  if (!moduleEnabled) {
    return (
      <ModuleNotice
        title="DocuDent disabled"
        description="Damage submissions are not available in this build."
        message="Enable NEXT_PUBLIC_MODULE_DOCUDENT to continue."
      />
    );
  }

  if (!hasScope) {
    return (
      <EmptyState title="Organization context required" description="Inspections become available after a tenant session is selected." />
    );
  }

  const totalFiles = files.length;
  const activeStep = docuDentSteps[currentStep];
  const isReviewStep = currentStep === docuDentSteps.length - 1;
  const submissionBadgeLabel =
    submissionState.status === "success"
      ? "Submitted"
      : submissionState.status === "error"
        ? "Submit failed"
        : "Submission pending";
  const submissionBadgeTone =
    submissionState.status === "success"
      ? "positive"
      : submissionState.status === "error"
        ? "danger"
        : "neutral";

  const isCurrentStepValid = (index: number) => {
    const key = docuDentSteps[index].id;
    if (key === "vehicle") {
      return !fieldError.vehicle;
    }
    if (key === "area") {
      return !fieldError.area;
    }
    if (key === "type") {
      return !fieldError.type;
    }
    if (key === "severity") {
      return !fieldError.severity;
    }
    if (key === "notes") {
      return !fieldError.notes;
    }
    if (key === "files") {
      return !fieldError.files;
    }
    return true;
  };

  const handleNext = () => {
    if (!isCurrentStepValid(currentStep)) return;
    if (currentStep < docuDentSteps.length - 1) {
      setCurrentStep(currentStep + 1);
    }
  };

  const handlePrev = () => {
    if (currentStep > 0) {
      setCurrentStep(currentStep - 1);
    }
  };

  const handleReviewSubmit = async () => {
    if (currentStep !== docuDentSteps.length - 1) return;
    if (!isCurrentStepValid(currentStep)) return;
    if (isSubmitting) return;
    setIsSubmitting(true);
    const reportId = deriveReportId();
    let attachmentsSummary: UploadSummary | undefined;
    try {
      if (files.length) {
        setSubmissionState({ status: "idle", message: "Uploading attachments...", reportId });
        attachmentsSummary = await uploadAttachments(reportId, files);
      }
      setSubmissionState({ status: "idle", message: "Submitting report...", reportId, attachments: attachmentsSummary });
      const result = await submitInspection(formState, { reportId, attachments: attachmentsSummary });
      PersistenceService.clearDraft();
      setSubmissionState({
        status: "success",
        message: `Report ${result.reportId} submitted (${files.length} attachment${files.length === 1 ? "" : "s"}).`,
        reportId: result.reportId,
        attachments: attachmentsSummary,
      });
    } catch (error) {
      console.error("DocuDent submission failed", error);
      const errorMessage = error instanceof Error ? error.message : "Network or server failure.";
      
      await PersistenceService.stashReport(reportId, formState, errorMessage, files);
      setStashedReports(PersistenceService.listStashed());

      setSubmissionState({
        status: "error",
        message: `Submission failed. Report #${reportId.substring(0, 8)} has been stashed locally (including ${files.length} files) for later retry.`,
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleRetryStash = async (report: StashedReport) => {
    setIsSubmitting(true);
    setSubmissionState({ status: "idle", message: `Retrying stashed report #${report.id.substring(0, 8)}...` });
    try {
      let attachmentsSummary: UploadSummary | undefined;
      
      // Attempt to recover files from IndexedDB
      if (report.hasAttachments) {
        const recoveredFiles = await PersistenceService.getStashedAttachments(report.id);
        if (recoveredFiles && recoveredFiles.length > 0) {
          setSubmissionState({ status: "idle", message: "Uploading recovered attachments...", reportId: report.id });
          attachmentsSummary = await uploadAttachments(report.id, recoveredFiles);
        }
      }

      setSubmissionState({ status: "idle", message: "Syncing report metadata...", reportId: report.id, attachments: attachmentsSummary });
      await submitInspection(report.state, { reportId: report.id, attachments: attachmentsSummary });
      
      await PersistenceService.removeFromStash(report.id);
      setStashedReports(PersistenceService.listStashed());
      setSubmissionState({ status: "success", message: `Stashed report #${report.id.substring(0, 8)} synced successfully.` });
    } catch (error) {
      console.error("Retry failed", error);
      setSubmissionState({ status: "error", message: "Retry failed. Keeping in stash." });
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleClearStash = async (id: string) => {
    await PersistenceService.removeFromStash(id);
    setStashedReports(PersistenceService.listStashed());
  };

  const renderStepContent = () => {
    switch (activeStep.id) {
      case "vehicle":
        return (
          <div className="space-y-4">
            <label className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Vehicle identifier</label>
            <input
              value={formState.vin}
              onChange={(event) => setFormState({ ...formState, vin: event.target.value.toUpperCase() })}
              placeholder="Enter VIN"
              className="w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm font-mono tracking-[0.1em] uppercase focus:border-slate-400 focus:outline-none"
            />
            <p className="text-[10px] text-slate-500">Use VIN or another vehicle identifier if VIN is unavailable.</p>
            <label className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Manual reference</label>
            <input
              value={formState.manualIdentifier}
              onChange={(event) => setFormState({ ...formState, manualIdentifier: event.target.value })}
              placeholder="Reference ID or rack"
              className="w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm focus:border-slate-400 focus:outline-none"
            />
            {fieldError.vehicle && <p className="text-[10px] text-rose-500">{fieldError.vehicle}</p>}
          </div>
        );
      case "area":
        return (
          <div className="space-y-4">
            <p className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Damage area</p>
            <div className="grid grid-cols-1 gap-3">
              <select
                value={formState.damageArea}
                onChange={(event) =>
                  setFormState({
                    ...formState,
                    damageArea: event.target.value as DocuDentDamageArea,
                    damageType: "",
                  })
                }
                className={`rounded-2xl border px-4 py-3 text-sm font-black uppercase tracking-tight transition w-full ${
                  formState.damageArea
                    ? "border-slate-300 bg-slate-50 text-slate-900"
                    : "border-slate-200 bg-white text-slate-600"
                }`}>
                <option value="">Select an area</option>
                {(["Exterior", "Interior", "Engine Bay"] as const).map((category) => (
                  <optgroup key={category} label={category}>
                    {DAMAGE_AREAS.filter((area) => area.category === category).map((area) => (
                      <option key={area.code} value={area.code}>
                        {area.code} - {area.name}
                      </option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </div>
            {selectedAreaOption ? (
              <p className="text-xs text-slate-500">
                Selected: {selectedAreaOption.code} - {selectedAreaOption.name}
              </p>
            ) : null}
            {fieldError.area && <p className="text-[10px] text-rose-500">{fieldError.area}</p>}
          </div>
        );
      case "type":
        return (
          <div className="space-y-4">
            <p className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Damage type</p>
            <div className="grid grid-cols-1 gap-3">
              <select
                value={formState.damageType}
                onChange={(event) => setFormState({ ...formState, damageType: event.target.value as DocuDentDamageType })}
                className={`rounded-2xl border px-4 py-3 text-sm font-black uppercase tracking-tight transition w-full ${
                  formState.damageType
                    ? "border-slate-300 bg-slate-50 text-slate-900"
                    : "border-slate-200 bg-white text-slate-600"
                }`}>
                <option value="">Select a type</option>
                {damageTypeOptions.length > 0 ? (
                  damageTypeOptions.map((type) => (
                    <option key={type.code} value={type.code}>
                      {type.code} - {type.name}
                    </option>
                  ))
                ) : (
                  <option value="" disabled>
                    Select a damage area first
                  </option>
                )}
              </select>
            </div>
            {selectedTypeOption ? (
              <p className="text-xs text-slate-500">
                Selected: {selectedTypeOption.code} - {selectedTypeOption.name}
              </p>
            ) : formState.damageArea ? (
              <p className="text-xs text-slate-500">Damage types are filtered for the selected area.</p>
            ) : null}
            {fieldError.type && <p className="text-[10px] text-rose-500">{fieldError.type}</p>}
          </div>
        );
      case "severity":
        return (
          <div className="space-y-4">
            <p className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Severity</p>
            <div className="grid grid-cols-1 gap-3">
              <select
                value={formState.severity}
                onChange={(event) => setFormState({ ...formState, severity: event.target.value as DocuDentSeverity })}
                className={`rounded-2xl border px-4 py-3 text-sm font-black uppercase tracking-tight transition w-full ${
                  formState.severity
                    ? "border-slate-300 bg-slate-50 text-slate-900"
                    : "border-slate-200 bg-white text-slate-600"
                }`}>
                <option value="">Select a severity</option>
                {DAMAGE_SEVERITIES.map((level) => (
                  <option key={level.value} value={level.value}>{level.label}</option>
                ))}
              </select>
            </div>
            {formState.severity ? (
              <p className="text-xs text-slate-500">
                Selected: {DAMAGE_SEVERITIES.find((level) => level.value === formState.severity)?.label || formState.severity}
              </p>
            ) : null}
            {fieldError.severity && <p className="text-[10px] text-rose-500">{fieldError.severity}</p>}
          </div>
        );
      case "notes":
        return (
          <div className="space-y-4">
            <p className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Inspection notes</p>
            <textarea
              rows={4}
              value={formState.notes}
              onChange={(event) => setFormState({ ...formState, notes: event.target.value })}
              placeholder="Capture context, observations, operator instructions, and repair guidance."
              className="w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm focus:border-slate-400 focus:outline-none"
            />
            {fieldError.notes && <p className="text-[10px] text-rose-500">{fieldError.notes}</p>}
          </div>
        );
      case "files":
        return (
          <div className="space-y-4">
            <p className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Attachments</p>
            <FileUploadPanel files={files} onFilesChange={setFiles} />
            {fieldError.files && <p className="text-[10px] text-rose-500">{fieldError.files}</p>}
          </div>
        );
      case "review":
        return (
          <div className="space-y-4">
            <p className="text-xs font-bold uppercase tracking-[0.4em] text-slate-500">Review submission</p>
            <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4 space-y-2">
              <p className="text-sm font-bold uppercase tracking-tight">{reviewLabels.vehicle}</p>
              <p className="text-xs uppercase tracking-[0.3em] text-slate-400">
                VIN: {formState.vin || "(manual entry)"}
              </p>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div className="rounded-2xl border border-slate-200 p-3">
                <p className="text-[9px] uppercase tracking-[0.3em] text-slate-400">{reviewLabels.damageArea}</p>
                <p className="text-sm font-black text-slate-900">{formState.damageArea || "—"}</p>
              </div>
              <div className="rounded-2xl border border-slate-200 p-3">
                <p className="text-[9px] uppercase tracking-[0.3em] text-slate-400">{reviewLabels.damageType}</p>
                <p className="text-sm font-black text-slate-900">{formState.damageType || "—"}</p>
              </div>
              <div className="rounded-2xl border border-slate-200 p-3">
                <p className="text-[9px] uppercase tracking-[0.3em] text-slate-400">{reviewLabels.severity}</p>
                <p className="text-sm font-black text-slate-900">{formState.severity || "—"}</p>
              </div>
            </div>
            <div className="rounded-2xl border border-slate-200 p-4">
              <p className="text-[9px] uppercase tracking-[0.3em] text-slate-400">{reviewLabels.notes}</p>
              <p className="text-sm text-slate-700">{formState.notes || "No notes provided."}</p>
            </div>
            <div className="rounded-2xl border border-slate-200 p-4 flex items-center justify-between">
              <div>
                <p className="text-[9px] uppercase tracking-[0.3em] text-slate-400">{reviewLabels.attachments}</p>
                <p className="text-sm font-black text-slate-900">{totalFiles} file(s)</p>
              </div>
              <StatusBadge label={submissionBadgeLabel} tone={submissionBadgeTone} />
            </div>
          </div>
        );
      default:
        return null;
    }
  };

  return (
    <article className="space-y-6">
      {loadError ? <ErrorPanel error={loadError} title="Recent inspections unavailable" /> : null}
      <Card>
        <CardHeader title="Valad Dent inspection" subtitle="Web-native equivalent of the mobile inspection workflow." />
        <CardContent>
          <div className="grid gap-6 lg:grid-cols-[260px,1fr]">
            <nav className="space-y-3">
              {docuDentSteps.map((step, index) => (
                <button
                  key={step.id}
                  type="button"
                  onClick={() => index <= currentStep && setCurrentStep(index)}
                  className={`w-full rounded-2xl border px-4 py-3 text-left transition ${
                    index === currentStep
                      ? "border-slate-300 bg-slate-50 text-slate-900"
                      : "border-slate-200 bg-white text-slate-600"
                  }`}
                >
                  <p className="text-[10px] font-black uppercase tracking-[0.3em]">Step {index + 1}</p>
                  <p className="text-sm font-black tracking-tight">{step.label}</p>
                  <p className="text-[9px] uppercase tracking-[0.4em] text-slate-400">{step.description}</p>
                </button>
              ))}
            </nav>
            <section className="space-y-6">
              <div className="rounded-3xl border border-slate-200 bg-white p-6">
                {renderStepContent()}
              </div>
              <div className="flex items-center justify-between">
                <button
                  type="button"
                  onClick={handlePrev}
                  disabled={currentStep === 0 || isSubmitting}
                  className="px-5 py-2 text-xs font-black uppercase tracking-tighter text-slate-500 disabled:opacity-40"
                >
                  Back
                </button>
                <button
                  type="button"
                  onClick={isReviewStep ? handleReviewSubmit : handleNext}
                  disabled={
                    isReviewStep
                      ? isSubmitting || !isCurrentStepValid(currentStep)
                      : !isCurrentStepValid(currentStep)
                  }
                  className="rounded-md bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400 inline-flex items-center gap-2"
                >
                  {isReviewStep ? (isSubmitting ? "Submitting…" : "Submit report") : "Next"}
                </button>
              </div>
              {submissionState.message && (
                <p
                  className={`text-[10px] ${
                    submissionState.status === "error" ? "text-rose-500" : "text-slate-500"
                  }`}
                >
                  {submissionState.message}
                </p>
              )}
              {submissionState.reportId && (
                <p className="text-[9px] uppercase tracking-[0.3em] text-slate-400">
                  Report ID: {submissionState.reportId}
                </p>
              )}
            </section>
          </div>
        </CardContent>
      </Card>

      {stashedReports.length > 0 && (
        <Card>
          <CardHeader title="Pending sync" />
          <CardContent>
            <div className="grid gap-3">
              {stashedReports.map((report) => (
                <div key={report.id} className="flex items-center justify-between rounded-2xl border border-rose-100 bg-rose-50/30 px-4 py-3 text-sm">
                  <div>
                    <p className="font-black uppercase tracking-tight text-slate-900">{report.state.vin || "Unknown ID"}</p>
                    <p className="text-[10px] uppercase tracking-[0.2em] text-rose-500 font-bold">Failed: {report.error || "Network error"}</p>
                  </div>
                  <div className="flex items-center gap-2">
                     <button 
                      onClick={() => handleClearStash(report.id)}
                      className="p-2 text-slate-400 hover:text-rose-600 transition-colors"
                     >
                       Clear
                     </button>
                     <button 
                      onClick={() => handleRetryStash(report)}
                      disabled={isSubmitting}
                      className="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400 inline-flex items-center gap-2"
                     >
                       <RefreshCw className={`w-3 h-3 ${isSubmitting ? 'animate-spin' : ''}`} />
                       Retry Sync
                     </button>
                  </div>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      <Card>
        <CardHeader title="Recent inspections" subtitle="Mirror of the last 5 findings from the mobile feed." />
        <CardContent>
          <div className="grid gap-4 md:grid-cols-2">
            <StatCard label="Loaded reports" value={stats.total} detail="Total inspections" />
            <StatCard label="Pending" value={stats.pending} detail="Awaiting review" />
          </div>
          <div className="mt-4 grid gap-3">
            {loading ? (
              <div className="py-8 text-center text-sm text-slate-400">Loading recent scans…</div>
            ) : (
              reports.slice(0, 5).map((report) => (
                <Link
                  key={report.report_id}
                  href={`/reports/damage?focus=${report.report_id}`}
                  className="flex items-center justify-between rounded-2xl border border-slate-200 px-4 py-3 text-sm hover:border-slate-400 transition"
                >
                  <div>
                    <p className="font-black uppercase tracking-tight text-slate-900">{report.vin || "Unknown VIN"}</p>
                    <p className="text-[10px] uppercase tracking-[0.3em] text-slate-500">
                      {report.make} {report.model}
                    </p>
                  </div>
                  <div className="flex items-center gap-2 text-[11px] text-slate-400 uppercase tracking-[0.3em]">
                    <History className="w-4 h-4" />
                    <span>{new Date(report.created_at ?? report.updated_at ?? Date.now()).toLocaleDateString()}</span>
                  </div>
                </Link>
              ))
            )}
          </div>
        </CardContent>
      </Card>

    </article>
  );
}

