const auth0Domain = process.env.NEXT_PUBLIC_AUTH0_DOMAIN || "nulanesystems.us.auth0.com";
const auth0ClientId = process.env.NEXT_PUBLIC_AUTH0_CLIENT_ID || "";
const auth0Audience = process.env.NEXT_PUBLIC_AUTH0_AUDIENCE || "https://api.nulanesystems.com";

const bootstrapScript = `
(function () {
  function bySelector(selector) {
    return document.querySelector(selector);
  }

  function setStatus(value) {
    var status = bySelector("[data-auth0-bootstrap-status]");
    var state = bySelector("[data-auth0-bootstrap-state]");
    if (status) {
      status.textContent = value;
    }
    if (state) {
      state.textContent = value;
    }
    console.debug("[Auth0Bootstrap]", value);
  }

  function setError(err) {
    var error = bySelector("[data-auth0-bootstrap-error]");
    var message = err && err.message ? err.message : String(err || "unknown error");
    if (error) {
      error.textContent = message;
    }
    console.error("[Auth0Bootstrap]", err);
  }

  function getReturnTo() {
    try {
      return new URLSearchParams(window.location.search).get("returnTo") || "/dashboard";
    } catch (error) {
      return "/dashboard";
    }
  }

  function loadAuth0Script() {
    return new Promise(function (resolve, reject) {
      if (window.auth0 && window.auth0.createAuth0Client) {
        resolve();
        return;
      }

      setStatus("loading-auth0-script");

      var existing = document.querySelector("script[data-auth0-spa-js]");
      if (existing) {
        existing.addEventListener("load", function () {
          resolve();
        }, { once: true });
        existing.addEventListener("error", function () {
          reject(new Error("Auth0 script failed to load."));
        }, { once: true });
        return;
      }

      var script = document.createElement("script");
      script.src = "https://cdn.auth0.com/js/auth0-spa-js/2.6/auth0-spa-js.production.js";
      script.async = true;
      script.dataset.auth0SpaJs = "true";
      script.onload = function () {
        resolve();
      };
      script.onerror = function () {
        reject(new Error("Auth0 script failed to load."));
      };
      document.head.appendChild(script);
    });
  }

  async function startAuth0Login() {
    try {
      setStatus("script-started");

      var returnTo = getReturnTo();
      var redirectUri = window.location.origin;
      var domain = ${JSON.stringify(auth0Domain)};
      var clientId = ${JSON.stringify(auth0ClientId)};
      var audience = ${JSON.stringify(auth0Audience)};

      if (!domain || !clientId || !audience) {
        throw new Error("Missing Auth0 domain/clientId/audience.");
      }

      var returnToNode = bySelector("[data-auth0-return-to]");
      if (returnToNode) {
        returnToNode.textContent = returnTo;
      }

      window.__portalAuth0LoginState = {
        returnTo: returnTo,
        redirectUri: redirectUri,
        domain: domain,
        clientId: clientId,
        audience: audience,
      };

      await loadAuth0Script();
      setStatus("script-loaded");

      if (!window.auth0 || !window.auth0.createAuth0Client) {
        throw new Error("Auth0 client is unavailable after loading the SDK.");
      }

      var client = await window.auth0.createAuth0Client({
        domain: domain,
        clientId: clientId,
        authorizationParams: {
          audience: audience,
          redirect_uri: redirectUri,
        },
        cacheLocation: "localstorage",
        useRefreshTokens: true,
      });

      setStatus("client-created");
      setStatus("redirecting");

      await client.loginWithRedirect({
        appState: { returnTo: returnTo },
        authorizationParams: {
          audience: audience,
          redirect_uri: redirectUri,
          prompt: "login",
        },
      });
    } catch (err) {
      setStatus("failed");
      setError(err);
      setStatus("failed: " + (err && err.message ? err.message : String(err || "unknown error")));
    }
  }

  window.__portalStartAuth0Login = startAuth0Login;

  var retryButton = bySelector("[data-auth0-bootstrap-retry]");
  if (retryButton) {
    retryButton.addEventListener("click", function () {
      void window.__portalStartAuth0Login();
    });
  }

  void window.__portalStartAuth0Login();
})();
`;

export default function LoginPage() {
  return (
    <main className="flex min-h-screen items-center justify-center bg-[radial-gradient(circle_at_top,_rgba(15,23,42,0.06),_transparent_42%),linear-gradient(180deg,#f8fafc_0%,#eef2ff_100%)] px-6 text-slate-900">
      <script dangerouslySetInnerHTML={{ __html: bootstrapScript }} />
      <div className="w-full max-w-lg rounded-[2rem] border border-white/70 bg-white/85 px-8 py-10 text-center shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur">
        <p className="text-[10px] font-black uppercase tracking-[0.35em] text-slate-400">Authentication</p>
        <h1 className="mt-3 text-3xl font-black tracking-tight text-slate-950">Opening sign-in</h1>
        <p className="mt-2 max-w-md text-sm leading-relaxed text-slate-500">
          Redirecting to Auth0 so you can continue to the portal.
        </p>
        <p className="mt-3 text-[11px] font-semibold uppercase tracking-[0.24em] text-slate-400" data-auth0-bootstrap-status>
          script-started
        </p>
        <p className="mt-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-rose-600" data-auth0-bootstrap-error />
        <div className="mt-5 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-left text-xs leading-relaxed text-slate-600">
          <p className="font-black uppercase tracking-[0.24em] text-slate-400">Debug</p>
          <p className="mt-2">
            Return target: <span className="font-semibold text-slate-800" data-auth0-return-to>/dashboard</span>
          </p>
          <p className="mt-1">
            State: <span className="font-semibold text-slate-800" data-auth0-bootstrap-state>script-started</span>
          </p>
          <p className="mt-1">
            Location:{" "}
            <span className="font-semibold text-slate-800">{typeof window !== "undefined" ? window.location.origin : "server"}</span>
          </p>
          <p className="mt-1">
            Auth0 domain: <span className="font-semibold text-slate-800">{auth0Domain || "unknown"}</span>
          </p>
          <button
            type="button"
            data-auth0-bootstrap-retry
            className="mt-4 inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50"
          >
            Try sign-in again
          </button>
        </div>
      </div>
    </main>
  );
}
