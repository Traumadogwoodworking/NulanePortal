"use client";

import { useEffect, useState } from "react";

export function HydrationProbe() {
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    console.log("[HydrationProbe] mounted", window.location.href);
    setMounted(true);
    document.documentElement.setAttribute("data-login-hydrated", "true");
  }, []);

  return (
    <div
      style={{
        position: "fixed",
        left: 12,
        bottom: 12,
        zIndex: 99999,
        padding: "8px 10px",
        borderRadius: 8,
        background: mounted ? "#16a34a" : "#dc2626",
        color: "white",
        fontSize: 12,
        fontWeight: 700,
      }}
    >
      login hydration: {mounted ? "mounted" : "not mounted"}
    </div>
  );
}
