import { Suspense } from "react";
import Script from "next/script";
import { LoginRedirectClient } from "./LoginRedirectClient";

export default function LoginPage() {
  const auth0Domain = process.env.NEXT_PUBLIC_AUTH0_DOMAIN || "nulanesystems.us.auth0.com";
  const auth0ClientId = process.env.NEXT_PUBLIC_AUTH0_CLIENT_ID || "WkYT29HkNJo5rjDMPGTxAdb04QdKQsPc";
  const auth0Audience = process.env.NEXT_PUBLIC_AUTH0_AUDIENCE || "https://api.nulanesystems.com";
  const auth0RedirectUri = process.env.NEXT_PUBLIC_AUTH0_REDIRECT_URI || "";

  return (
    <>
      <Script id="portal-auth0-login-bootstrap" strategy="afterInteractive">
        {`
          (function () {
            if (window.__portalAuth0LoginStarted) {
              return;
            }
            window.__portalAuth0LoginStarted = true;
            var config = {
              domain: ${JSON.stringify(auth0Domain)},
              clientId: ${JSON.stringify(auth0ClientId)},
              audience: ${JSON.stringify(auth0Audience)},
              redirectOverride: ${JSON.stringify(auth0RedirectUri)},
            };
            var returnTo = new URLSearchParams(window.location.search).get("returnTo") || "/dashboard";
            var statusNode = document.querySelector("[data-login-status-text]");
            function setStatus(text) {
              if (statusNode) {
                statusNode.textContent = text;
              }
            }
            function log() {
              try {
                console.debug.apply(console, ["[Auth0 login bootstrap]"].concat([].slice.call(arguments)));
              } catch (error) {}
            }
            async function loadAuth0Script() {
              if (window.auth0 && typeof window.auth0.createAuth0Client === "function") {
                return window.auth0;
              }
              await new Promise(function (resolve, reject) {
                var existing = document.querySelector("script[data-auth0-spa-js]");
                if (existing) {
                  existing.addEventListener("load", function () { resolve(); }, { once: true });
                  existing.addEventListener("error", function () { reject(new Error("Unable to load Auth0 client script.")); }, { once: true });
                  return;
                }
                var script = document.createElement("script");
                script.src = "https://cdn.auth0.com/js/auth0-spa-js/2.6/auth0-spa-js.production.js";
                script.async = true;
                script.dataset.auth0SpaJs = "true";
                script.onload = function () { resolve(); };
                script.onerror = function () { reject(new Error("Unable to load Auth0 client script.")); };
                document.head.appendChild(script);
              });
              return window.auth0;
            }
            (async function () {
              try {
                setStatus("redirecting");
                log("starting", { returnTo: returnTo, origin: window.location.origin, config: config });
                if (!config.domain || !config.clientId || !config.audience) {
                  throw new Error("Missing Auth0 config on login page.");
                }
                var auth0 = await loadAuth0Script();
                var client = await auth0.createAuth0Client({
                  domain: config.domain,
                  clientId: config.clientId,
                  authorizationParams: {
                    audience: config.audience,
                    redirect_uri: config.redirectOverride || window.location.origin,
                    prompt: "login"
                  },
                  cacheLocation: "localstorage",
                  useRefreshTokens: true
                });
                await client.loginWithRedirect({
                  appState: { returnTo: returnTo },
                  authorizationParams: {
                    audience: config.audience,
                    redirect_uri: config.redirectOverride || window.location.origin,
                    prompt: "login"
                  }
                });
              } catch (error) {
                console.warn("[Auth0 login bootstrap] failed", error);
                setStatus("failed");
                if (statusNode) {
                  statusNode.setAttribute("data-login-error", error && error.message ? error.message : "unknown error");
                }
              }
            })();
          })();
        `}
      </Script>
      <Suspense
        fallback={
          <main className="flex min-h-screen items-center justify-center bg-[radial-gradient(circle_at_top,_rgba(15,23,42,0.06),_transparent_42%),linear-gradient(180deg,#f8fafc_0%,#eef2ff_100%)] px-6 text-slate-900">
            <div className="rounded-[2rem] border border-white/70 bg-white/85 px-8 py-10 text-center shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur">
              <p className="text-[10px] font-black uppercase tracking-[0.35em] text-slate-400">Authentication</p>
              <h1 className="mt-3 text-3xl font-black tracking-tight text-slate-950">Opening sign-in</h1>
              <p className="mt-2 max-w-md text-sm leading-relaxed text-slate-500">
                Redirecting to Auth0 so you can continue to the portal.
              </p>
            </div>
          </main>
        }
      >
        <LoginRedirectClient />
      </Suspense>
    </>
  );
}
