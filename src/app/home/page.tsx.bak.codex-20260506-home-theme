"use client";

import { useMemo } from "react";
import { BarChart3 } from "lucide-react";
import { PageSection } from "@/components/ui/PageSection";
import { EmptyState } from "@/components/ui/EmptyState";
import { FacilityDamageStatsPanel } from "@/components/facilities/FacilityDamageStats";
import { usePortalDirectorySnapshot } from "@/lib/portalData";
import { usePortalReports } from "@/lib/portalReports";
import { usePortalSession } from "@/lib/portalSession";
import { buildFacilityDamageStats } from "@/lib/facilityDamageStats";

export default function HomePage() {
  const { organizationId } = usePortalSession();
  const { data: directory, isLoading, error } = usePortalDirectorySnapshot();
  const portalReports = usePortalReports();

  const facilities = useMemo(() => directory?.facilities ?? [], [directory]);
  const damageReports = useMemo(() => portalReports?.damageReports ?? [], [portalReports?.damageReports]);
  const facilityDamageStats = useMemo(
    () => buildFacilityDamageStats(damageReports, facilities),
    [damageReports, facilities]
  );

  if (!organizationId) {
    return <EmptyState title="Home unavailable" description="Organization session required." />;
  }

  return (
    <div className="space-y-6">
      <PageSection title="Home" description="Portal overview and facility recipient assignments." variant="panel">
        {isLoading ? (
          <div className="py-12 text-center text-sm text-slate-500">Loading home data...</div>
        ) : error ? (
          <EmptyState title="Home data unavailable" description="Directory snapshot could not be loaded." tone="danger" />
        ) : (
          <div className="space-y-6">
            <div className="space-y-3">
              <div className="flex items-center gap-2">
                <BarChart3 className="h-5 w-5 text-slate-500" />
                <h2 className="text-base font-bold uppercase tracking-[0.2em] text-slate-900">Damage Activity</h2>
              </div>
              <div className="rounded-2xl border border-slate-200 bg-white p-4">
                <div className="flex h-20 items-end gap-2">
                  {facilityDamageStats.slice(0, 8).map((stats) => (
                    <div key={stats.key} className="flex flex-1 flex-col items-center gap-2">
                      <div
                        className="w-full rounded-t-lg bg-slate-200"
                        style={{ height: `${Math.max(18, Math.min(80, stats.totalReports * 8))}px` }}
                      />
                      <span className="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500 truncate w-full text-center">
                        {stats.label}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
              <div className="grid gap-4 xl:grid-cols-2">
                {facilityDamageStats.slice(0, 4).map((stats) => (
                  <FacilityDamageStatsPanel key={stats.key} stats={stats} />
                ))}
                {facilityDamageStats.slice(4, 6).map((stats) => (
                  <FacilityDamageStatsPanel key={stats.key} stats={stats} />
                ))}
              </div>
            </div>
          </div>
        )}
      </PageSection>
    </div>
  );
}
