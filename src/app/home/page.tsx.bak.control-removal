"use client";

import { useMemo } from "react";
import Link from "next/link";
import { ArrowRight, History, LayoutGrid, ShieldAlert, FileText } from "lucide-react";
import { PageSection } from "@/components/ui/PageSection";
import { EmptyState } from "@/components/ui/EmptyState";
import { FacilityDamageStatsPanel } from "@/components/facilities/FacilityDamageStats";
import { usePortalDirectorySnapshot } from "@/lib/portalData";
import { usePortalReports } from "@/lib/portalReports";
import { usePortalSession } from "@/lib/portalSession";
import { buildFacilityDamageStats } from "@/lib/facilityDamageStats";

export default function HomePage() {
  const { organizationId } = usePortalSession();
  const { data: directory, isLoading, error } = usePortalDirectorySnapshot();
  const portalReports = usePortalReports();

  const facilities = useMemo(() => directory?.facilities ?? [], [directory]);
  const damageReports = useMemo(() => portalReports?.damageReports ?? [], [portalReports?.damageReports]);
  const facilityDamageStats = useMemo(
    () => buildFacilityDamageStats(damageReports, facilities).sort((a, b) => b.totalReports - a.totalReports),
    [damageReports, facilities]
  );
  const todayIso = new Date().toISOString().slice(0, 10);
  const rsaReportsToday = useMemo(
    () =>
      (portalReports?.rsaReports ?? []).filter((report) => {
        const value = report.created_at || report.updated_at;
        return Boolean(value && value.slice(0, 10) === todayIso);
      }),
    [portalReports?.rsaReports, todayIso]
  );
  const quickLinks = [
    { href: "/reports/damage", label: "Damage reports", description: "Open the live damage report list." },
    { href: "/reports/rsa", label: "RSA reports", description: "Review rail and route records." },
    { href: "/dashboard", label: "Dashboard", description: "Open the embedded analytics surface." },
    { href: "/control", label: "Control", description: "Jump to operations tooling." },
  ];

  if (!organizationId) {
    return <EmptyState title="Home unavailable" description="Organization session required." />;
  }

  return (
    <div className="space-y-6">
      <PageSection title="Home" description="Portal overview and facility recipient assignments." variant="panel">
        {isLoading ? (
          <div className="py-12 text-center text-sm text-slate-500">Loading home data...</div>
        ) : error ? (
          <EmptyState title="Home data unavailable" description="Directory snapshot could not be loaded." tone="danger" />
        ) : (
          <div className="space-y-6">
            <div className="grid gap-4 xl:grid-cols-[minmax(0,1.2fr)_minmax(340px,0.8fr)]">
              <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_18px_50px_-26px_rgba(15,23,42,0.2)]">
                <div className="flex items-start justify-between gap-4">
                  <div>
                    <p className="text-[10px] font-black uppercase tracking-[0.32em] text-slate-500">RSA reports today</p>
                    <p className="mt-2 text-4xl font-black tracking-tight text-slate-900">{rsaReportsToday.length}</p>
                    <p className="mt-1 text-sm text-slate-600">
                      {rsaReportsToday.length === 1 ? "1 report updated today." : `${rsaReportsToday.length} reports updated today.`}
                    </p>
                  </div>
                  <div className="rounded-2xl border border-slate-200 bg-slate-50 p-3 text-slate-500">
                    <ShieldAlert className="h-5 w-5" />
                  </div>
                </div>
                <div className="mt-5 grid gap-3 sm:grid-cols-2">
                  {quickLinks.map((link) => (
                    <Link
                      key={link.href}
                      href={link.href}
                      className="group rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 transition hover:border-slate-300 hover:bg-white"
                    >
                      <div className="flex items-center justify-between gap-3">
                        <div>
                          <p className="text-sm font-semibold text-slate-900">{link.label}</p>
                          <p className="mt-1 text-xs text-slate-600">{link.description}</p>
                        </div>
                        <ArrowRight className="h-4 w-4 text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-slate-700" />
                      </div>
                    </Link>
                  ))}
                </div>
              </div>

              <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-1">
                <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_18px_50px_-26px_rgba(15,23,42,0.2)]">
                  <div className="flex items-center gap-2">
                    <LayoutGrid className="h-4 w-4 text-slate-500" />
                    <p className="text-[10px] font-black uppercase tracking-[0.3em] text-slate-500">Facilities</p>
                  </div>
                  <p className="mt-3 text-3xl font-black text-slate-900">{facilities.length}</p>
                </div>
                <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_18px_50px_-26px_rgba(15,23,42,0.2)]">
                  <div className="flex items-center gap-2">
                    <History className="h-4 w-4 text-slate-500" />
                    <p className="text-[10px] font-black uppercase tracking-[0.3em] text-slate-500">Damage reports</p>
                  </div>
                  <p className="mt-3 text-3xl font-black text-slate-900">{damageReports.length}</p>
                </div>
              </div>
            </div>

            <div className="grid gap-4 xl:grid-cols-2">
              {facilityDamageStats.slice(0, 4).map((stats) => (
                <FacilityDamageStatsPanel key={stats.key} stats={stats} />
              ))}
              {facilityDamageStats.slice(4, 8).map((stats) => (
                <FacilityDamageStatsPanel key={stats.key} stats={stats} />
              ))}
            </div>

            <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_18px_50px_-26px_rgba(15,23,42,0.2)]">
              <div className="flex items-center gap-2">
                <FileText className="h-4 w-4 text-slate-500" />
                <h2 className="text-base font-bold uppercase tracking-[0.2em] text-slate-900">Damage Activity</h2>
              </div>
              <p className="mt-2 text-sm text-slate-600">
                Facilities are sorted from the most reported to the least reported so the busiest locations stay on top.
              </p>
            </div>
          </div>
        )}
      </PageSection>
    </div>
  );
}
