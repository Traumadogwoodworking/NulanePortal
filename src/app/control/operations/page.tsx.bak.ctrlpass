"use client";

import { useEffect, useState } from "react";
import { Rocket, ShieldCheck, Activity, Terminal } from "lucide-react";
import { usePortalSession } from "@/lib/portalSession";
import { 
  fetchReleases, 
  type ControlRelease 
} from "@/lib/services/controlPlaneService";
import { ControlSection } from "@/components/control/ControlSection";
import { ControlMetricTile } from "@/components/control/ControlMetricTile";
import { DataTableShell } from "@/components/ui/DataTableShell";
import { StatusBadge } from "@/components/ui/StatusBadge";
import { EmptyState } from "@/components/ui/EmptyState";
import { DetailDrawer } from "@/components/ui/DetailDrawer";
import { JsonInspector } from "@/components/ui/JsonInspector";

export default function ControlOperationsPage() {
  const { organizationId, isSuperAdmin } = usePortalSession();
  const [releases, setReleases] = useState<ControlRelease[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selectedRelease, setSelectedRelease] = useState<ControlRelease | null>(null);

  useEffect(() => {
    if (!organizationId) {
      setLoading(false);
      return;
    }

    let active = true;
    setLoading(true);

    void (async () => {
      try {
        const data = await fetchReleases();
        if (!active) return;
        setReleases(data);
      } catch (err) {
        if (!active) return;
        setError(err instanceof Error ? err.message : "Unable to load releases.");
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    })();

    return () => {
      active = false;
    };
  }, [organizationId]);

  const activeReleases = releases.filter(r => r.status === "active");
  const failedReleases = releases.filter(r => r.status === "failed");

  if (loading) {
    return (
      <div className="space-y-5 animate-pulse">
        <div className="grid gap-4 md:grid-cols-3">
          {Array.from({ length: 3 }).map((_, i) => (
            <div key={i} className="h-24 rounded-[1.5rem] bg-white/5 border border-white/10" />
          ))}
        </div>
        <div className="h-96 rounded-[1.75rem] bg-white/5 border border-white/10" />
      </div>
    );
  }

  if (!isSuperAdmin) {
    return (
      <div className="rounded-[1.75rem] border border-amber-400/20 bg-amber-500/10 p-6 text-amber-100">
        <p className="text-sm font-semibold uppercase tracking-[0.36em]">Super-admin only</p>
        <p className="mt-2 text-sm leading-6">
          Maintenance and release controls are reserved for global control operators.
        </p>
      </div>
    );
  }

  if (error) {
    return (
      <div className="rounded-[1.75rem] border border-rose-400/20 bg-rose-500/10 p-6 text-rose-100">
        <p className="text-sm font-semibold uppercase tracking-[0.36em]">Releases error</p>
        <p className="mt-2 text-sm leading-6">{error}</p>
      </div>
    );
  }

  return (
    <div className="space-y-5">
      <div className="grid gap-4 md:grid-cols-3">
        <ControlMetricTile
          label="Active releases"
          value={activeReleases.length}
          detail="Systems currently running latest code"
          tone={activeReleases.length ? "positive" : "neutral"}
          icon={<Rocket className="h-4 w-4" />}
        />
        <ControlMetricTile
          label="Total releases"
          value={releases.length}
          detail="History of deployments in this environment"
          icon={<Activity className="h-4 w-4" />}
        />
        <ControlMetricTile
          label="Failed attempts"
          value={failedReleases.length}
          detail="Historical deployment failures"
          tone={failedReleases.length ? "danger" : "positive"}
          icon={<ShieldCheck className="h-4 w-4" />}
        />
      </div>

      <ControlSection
        title="Release history"
        description="Deployment ledger for this environment. Derived from live control-plane data."
      >
        {releases.length ? (
          <div className="overflow-hidden rounded-[1.5rem] border border-white/10 bg-slate-950/40">
            <DataTableShell
              columns={[
                { id: "version", label: "Version" },
                { id: "env", label: "Environment" },
                { id: "status", label: "Status" },
                { id: "deployed_at", label: "Deployed At" },
                { id: "deployed_by", label: "By" },
                { id: "summary", label: "Summary" },
              ]}
              rowsCount={releases.length}
            >
              {releases.map((release) => (
                <tr 
                  key={release.id} 
                  className="border-b border-white/5 hover:bg-white/5 transition-colors cursor-pointer"
                  onClick={() => setSelectedRelease(release)}
                >
                  <td className="px-4 py-4 text-sm font-mono text-cyan-200">{release.version}</td>
                  <td className="px-4 py-4 text-sm text-slate-300">{release.environment}</td>
                  <td className="px-4 py-4">
                    <StatusBadge 
                      label={release.status} 
                      tone={release.status === "active" ? "positive" : release.status === "failed" ? "danger" : "neutral"} 
                    />
                  </td>
                  <td className="px-4 py-4 text-sm text-slate-400">
                    {new Date(release.deployed_at).toLocaleString()}
                  </td>
                  <td className="px-4 py-4 text-sm text-slate-300">{release.deployed_by}</td>
                  <td className="px-4 py-4 text-sm text-slate-400 max-w-xs truncate">{release.summary}</td>
                </tr>
              ))}
            </DataTableShell>
          </div>
        ) : (
          <div className="rounded-[1.5rem] border border-white/10 bg-slate-950/60 p-12">
            <EmptyState
              title="No releases found"
              description="The control-plane does not have any recorded releases for this environment."
            />
          </div>
        )}
      </ControlSection>

      <ControlSection
        title="Proof suites & Preflight"
        description="Automated verification bundles and preflight tools for release qualification."
        actions={<StatusBadge label="Missing Backend Routes" tone="warning" />}
      >
        <div className="rounded-[1.5rem] border border-dashed border-white/10 bg-white/5 p-8 text-center space-y-4">
          <p className="text-sm text-slate-400">
            Proof suite execution and preflight restoration actions are not available.
            The backend does not yet expose <code className="text-xs bg-black/40 px-1.5 py-0.5 rounded text-rose-300">/admin/control-plane/suites/proof</code> or related preflight execution endpoints.
          </p>
          <div className="flex justify-center gap-3">
             <button disabled className="px-4 py-2 border border-white/10 rounded-lg text-sm text-slate-500 bg-white/5 flex items-center gap-2 cursor-not-allowed">
               <Terminal className="w-4 h-4" /> Run Proof Suite
             </button>
             <button disabled className="px-4 py-2 border border-white/10 rounded-lg text-sm text-slate-500 bg-white/5 flex items-center gap-2 cursor-not-allowed">
               Restore Preflight
             </button>
          </div>
        </div>
      </ControlSection>

      <DetailDrawer 
        isOpen={!!selectedRelease} 
        onClose={() => setSelectedRelease(null)}
        title="Release Details"
      >
        {selectedRelease && (
          <div className="space-y-6">
            <div className="grid grid-cols-2 gap-4">
              <div className="p-4 rounded-xl bg-white/5 border border-white/10">
                <p className="text-xs text-slate-500 uppercase tracking-widest mb-1">Version</p>
                <p className="font-mono text-cyan-300 text-sm">{selectedRelease.version}</p>
              </div>
              <div className="p-4 rounded-xl bg-white/5 border border-white/10">
                <p className="text-xs text-slate-500 uppercase tracking-widest mb-1">Status</p>
                <div>
                  <StatusBadge 
                    label={selectedRelease.status} 
                    tone={selectedRelease.status === "active" ? "positive" : selectedRelease.status === "failed" ? "danger" : "neutral"} 
                  />
                </div>
              </div>
            </div>

            <div className="space-y-4">
              <h3 className="text-sm font-semibold tracking-wide text-slate-300 uppercase">Execution Panel</h3>
              <div className="p-4 rounded-xl border border-dashed border-white/10 bg-black/20 text-sm text-slate-400 leading-relaxed">
                Action triggers (Rollback, Promote) are disabled pending control-plane implementation.
              </div>
            </div>

            <div className="space-y-3">
              <h3 className="text-sm font-semibold tracking-wide text-slate-300 uppercase font-mono">Summary</h3>
              <p className="text-sm text-slate-400 leading-relaxed bg-black/40 p-4 rounded-xl border border-white/10">
                {selectedRelease.summary || "No summary provided for this release."}
              </p>
            </div>

            <div className="space-y-3">
              <h3 className="text-sm font-semibold tracking-wide text-slate-300 uppercase font-mono">Payload Preview</h3>
              <JsonInspector data={selectedRelease.metadata || { _note: "No metadata attached" }} />
            </div>
          </div>
        )}
      </DetailDrawer>
    </div>
  );
}
