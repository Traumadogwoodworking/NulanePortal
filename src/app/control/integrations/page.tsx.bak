"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { RefreshCw, ShieldCheck, Webhook } from "lucide-react";
import { usePortalSession } from "@/lib/portalSession";
import {
  fetchAdminSettings,
  fetchOperationsStatus,
  fetchReadinessStatus,
  normalizeControlTimestamp,
  type ControlOperationsStatus,
  type ControlReadyzStatus,
  type ControlSettingRecord,
} from "@/lib/services/controlPlaneService";
import { ControlBlockedSurface } from "@/components/control/ControlBlockedSurface";
import { ControlDetailPanel, type ControlDetailField } from "@/components/control/ControlDetailPanel";
import { ControlFilterBar } from "@/components/control/ControlFilterBar";
import { ControlMetricTile } from "@/components/control/ControlMetricTile";
import { ControlSection } from "@/components/control/ControlSection";
import { ControlTableShell } from "@/components/control/ControlTableShell";
import { StatusBadge } from "@/components/ui/StatusBadge";

type IntegrationRow = {
  id: string;
  key: string;
  scope: string;
  value: string;
  updatedAt: string | null;
  fields: ControlDetailField[];
};

function buildValueSummary(value: unknown): string {
  if (value == null) return "Empty";
  if (typeof value === "string") return value.length > 90 ? `${value.slice(0, 87)}...` : value;
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  if (Array.isArray(value)) return `${value.length} item(s)`;
  if (typeof value === "object") return `${Object.keys(value as Record<string, unknown>).length} field(s)`;
  return String(value);
}

function isIntegrationSetting(row: ControlSettingRecord): boolean {
  const key = (row.key || "").toLowerCase();
  return /formsite|telegram|auth0|ses|smtp|email|webhook|integration|stripe|notify|alert|storage|s3/.test(key);
}

function buildIntegrationRows(settings: ControlSettingRecord[]): IntegrationRow[] {
  return settings
    .filter(isIntegrationSetting)
    .map((row, index) => ({
      id: `${row.key || "setting"}-${index}`,
      key: row.key || "unknown",
      scope: `${row.scope_type || "global"}${row.scope_id ? ` · ${row.scope_id}` : ""}`,
      value: buildValueSummary(row.value),
      updatedAt: row.updated_at || null,
      fields: [
        { label: "Key", value: row.key || "Unknown" },
        { label: "Scope", value: row.scope_type || "global" },
        { label: "Scope ID", value: row.scope_id || "global" },
        { label: "Updated", value: row.updated_at ? new Date(row.updated_at).toLocaleString() : "Unknown" },
        { label: "Raw summary", value: buildValueSummary(row.value) },
      ],
    }));
}

export default function ControlIntegrationsPage() {
  const { organizationId } = usePortalSession();
  const [status, setStatus] = useState<ControlOperationsStatus | null>(null);
  const [readiness, setReadiness] = useState<ControlReadyzStatus | null>(null);
  const [settings, setSettings] = useState<ControlSettingRecord[]>([]);
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selectedId, setSelectedId] = useState<string | null>(null);

  useEffect(() => {
    if (!organizationId) {
      setLoading(false);
      return;
    }

    let active = true;
    setLoading(true);
    setError(null);

    void (async () => {
      try {
        const [statusResult, readinessResult, settingsResult] = await Promise.all([
          fetchOperationsStatus(),
          fetchReadinessStatus(),
          fetchAdminSettings(),
        ]);
        if (!active) return;
        setStatus(statusResult);
        setReadiness(readinessResult);
        setSettings(settingsResult);
      } catch (err) {
        if (!active) return;
        setError(err instanceof Error ? err.message : "Unable to load integration signals.");
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    })();

    return () => {
      active = false;
    };
  }, [organizationId]);

  const rows = useMemo(() => buildIntegrationRows(settings), [settings]);
  const filteredRows = useMemo(() => {
    const query = search.trim().toLowerCase();
    if (!query) {
      return rows;
    }
    return rows.filter((row) => [row.key, row.scope, row.value].join(" ").toLowerCase().includes(query));
  }, [rows, search]);
  const selectedRow = filteredRows.find((row) => row.id === selectedId) ?? filteredRows[0] ?? null;

  useEffect(() => {
    if (filteredRows.length && !filteredRows.some((row) => row.id === selectedId)) {
      setSelectedId(filteredRows[0].id);
    }
  }, [filteredRows, selectedId]);

  if (!organizationId) {
    return (
      <div className="rounded-[1.75rem] border border-amber-400/20 bg-amber-500/10 p-6 text-amber-100">
        Integrations surface requires an organization session.
      </div>
    );
  }

  if (loading) {
    return <div className="rounded-[1.75rem] border border-white/10 bg-white/5 p-6 text-slate-300">Loading integration signals...</div>;
  }

  if (error) {
    return <div className="rounded-[1.75rem] border border-rose-400/20 bg-rose-500/10 p-6 text-rose-100">{error}</div>;
  }

  const alertingEnabled = Boolean(status?.alerting?.enabled);
  const integrationSettingsCount = rows.length;

  return (
    <div className="space-y-5">
      <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <ControlMetricTile label="Integration settings" value={integrationSettingsCount} detail="Backend config rows" />
        <ControlMetricTile label="Ready" value={readiness?.status || status?.status || "Unknown"} detail={status?.summary || readiness?.error || "Trust boundary signal"} tone={status?.ready ? "positive" : "warning"} />
        <ControlMetricTile label="Alerting" value={alertingEnabled ? "Enabled" : "Disabled"} detail="Operations status payload" tone={alertingEnabled ? "positive" : "neutral"} />
        <ControlMetricTile label="Warnings" value={status?.warnings.length || 0} detail="Backend status warnings" tone={status?.warnings.length ? "warning" : "positive"} />
      </div>

      <ControlFilterBar
        search={search}
        onSearch={setSearch}
        placeholder="Search integration key, scope, or value summary"
        actions={
          <button
            type="button"
            onClick={() => {
              setLoading(true);
              void Promise.all([fetchOperationsStatus(), fetchReadinessStatus(), fetchAdminSettings()])
                .then(([statusResult, readinessResult, settingsResult]) => {
                  setStatus(statusResult);
                  setReadiness(readinessResult);
                  setSettings(settingsResult);
                })
                .finally(() => setLoading(false));
            }}
            className="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.28em] text-white transition hover:border-white/20 hover:bg-white/10"
          >
            <RefreshCw className="h-4 w-4" />
            Refresh
          </button>
        }
        summary={<StatusBadge label={`${filteredRows.length} matches`} tone="neutral" />}
      />

      <div className="grid gap-5 xl:grid-cols-[minmax(0,1.45fr)_minmax(340px,0.55fr)]">
        <ControlTableShell
          title="Integration trust boundaries"
          description="This surface is intentionally grounded in live status and settings rows instead of synthetic green checks."
          density="compact"
          columns={[
            { id: "key", label: "Setting" },
            { id: "scope", label: "Scope" },
            { id: "value", label: "Value" },
            { id: "updated", label: "Updated" },
          ]}
          rowsCount={filteredRows.length}
        >
          {filteredRows.map((row) => {
            const active = row.id === selectedRow?.id;
            return (
              <tr
                key={row.id}
                data-row-key={row.id}
                className={`cursor-pointer transition ${active ? "bg-cyan-400/10" : "hover:bg-white/5"}`}
                onClick={() => setSelectedId(row.id)}
              >
                <td className="px-3 py-3">
                  <p className="text-sm font-semibold text-white">{row.key}</p>
                </td>
                <td className="px-3 py-3 text-sm text-slate-300">{row.scope}</td>
                <td className="px-3 py-3 text-sm text-slate-300">{row.value}</td>
                <td className="px-3 py-3 text-sm text-slate-300">{normalizeControlTimestamp(row.updatedAt)}</td>
              </tr>
            );
          })}
        </ControlTableShell>

        <ControlDetailPanel
          title={selectedRow?.key || "Integration detail"}
          eyebrow="Connector signal"
          subtitle="Filterable view over integration-related settings and backend readiness signals."
          fields={selectedRow?.fields}
          footer={
            <div className="space-y-4">
              <div className="rounded-[1.35rem] border border-white/10 bg-white/5 p-4 text-sm text-slate-300">
                <p className="text-[10px] font-semibold uppercase tracking-[0.36em] text-slate-400">Live state</p>
                <p className="mt-2 leading-6">
                  {status?.summary || "No backend status summary returned."}
                </p>
                <p className="mt-2 text-xs text-slate-400">
                  {readiness?.status || "Readiness state unavailable"}{status?.failedDependencies.length ? ` · ${status.failedDependencies.length} failed dependency signal(s)` : ""}
                </p>
              </div>
              <div className="flex flex-wrap gap-2">
                <Link
                  href="/control/settings"
                  className="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.28em] text-white transition hover:border-white/20 hover:bg-white/10"
                >
                  Settings
                  <ShieldCheck className="h-4 w-4" />
                </Link>
                <Link
                  href="/control/outbox"
                  className="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.28em] text-white transition hover:border-white/20 hover:bg-white/10"
                >
                  Outbox
                  <Webhook className="h-4 w-4" />
                </Link>
              </div>
            </div>
          }
        />
      </div>

      <ControlSection title="Integration blockers" description="Keep the page honest about missing connector inventory and sync telemetry.">
        <ControlBlockedSurface
          title="No dedicated connector inventory API"
          description="The backend exposes useful settings and overall readiness, but it does not yet expose a first-class integration inventory, queue depth, or per-connector failure timeline for the control plane to render."
          blockers={[
            "No per-connector health endpoint is available for a true integration directory.",
            "No sync-depth or ingest-lag API is exposed for dashboards here.",
            "Trust-boundary controls remain split across settings, public ingest routes, and backend logs.",
          ]}
          liveNotes={[
            `${rows.length} integration-related settings row(s) were surfaced from the admin settings API.`,
            `${status?.warnings.length || 0} backend warning signal(s) were returned.`,
          ]}
          nextLinks={[
            { href: "/control/templates", label: "Open templates" },
            { href: "/control/overview", label: "Open overview" },
          ]}
        />
      </ControlSection>
    </div>
  );
}
