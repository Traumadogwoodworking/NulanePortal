"use client";

import type { ReactNode } from "react";
import { useMemo, useState } from "react";
import Link from "next/link";
import { 
  Activity, 
  BarChart3, 
  Mail, 
  Building2, 
  Settings2,
  ArrowRight,
  Database,
  AlertTriangle,
  Flag,
  Webhook,
  SlidersHorizontal,
  Mailbox,
  LayoutTemplate,
  History,
  FileSearch,
  Eye,
  ShieldAlert,
  Users,
} from "lucide-react";
import { usePortalControlSnapshots, usePortalDirectorySnapshot, usePortalReportsSnapshot } from "@/lib/portalData";
import { StatusBadge } from "@/components/ui/StatusBadge";

type TabKey = "overview" | "reports" | "email" | "orgs" | "operations";

interface TabDef {
  id: TabKey;
  label: string;
  icon: ReactNode;
}

const TABS: TabDef[] = [
  { id: "overview", label: "Overview", icon: <Activity className="w-4 h-4" /> },
  { id: "reports", label: "Reports", icon: <BarChart3 className="w-4 h-4" /> },
  { id: "email", label: "Email", icon: <Mail className="w-4 h-4" /> },
  { id: "orgs", label: "Organizations", icon: <Building2 className="w-4 h-4" /> },
  { id: "operations", label: "Operations", icon: <Settings2 className="w-4 h-4" /> },
];

export default function ControlPage() {
  const [activeTab, setActiveTab] = useState<TabKey>("overview");
  const { data: controlSnapshot } = usePortalControlSnapshots();
  const { data: directory } = usePortalDirectorySnapshot();
  const { data: reports } = usePortalReportsSnapshot();

  const summary = useMemo(() => ({
    ready: controlSnapshot?.status?.ready,
    health: controlSnapshot?.status?.summary || "Control-plane summary unavailable",
    users: directory?.users.length || 0,
    facilities: directory?.facilities.length || 0,
    emailLists: directory?.emailLists.length || 0,
    damage: reports?.damageReports.length || 0,
    rsa: reports?.rsaReports.length || 0,
  }), [controlSnapshot?.status?.ready, controlSnapshot?.status?.summary, directory?.emailLists.length, directory?.facilities.length, directory?.users.length, reports?.damageReports.length, reports?.rsaReports.length]);

  return (
    <div className="flex h-full w-full flex-col gap-6 px-6 py-6 lg:px-10">
      <div className="flex flex-col gap-4 rounded-[2rem] border border-slate-200/70 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950/60">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div className="flex items-center gap-2">
              <ShieldAlert className="w-4 h-4 text-rose-500" />
              <p className="text-[10px] font-black uppercase tracking-[0.42em] text-slate-400">Restricted Zone</p>
            </div>
            <h1 className="mt-2 text-3xl font-black text-slate-900 dark:text-white">Control Center</h1>
            <p className="mt-2 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
              Dense operator entry point for health, reports, email, tenant state, and operational surfaces.
              The tabs below keep the command surface visible while the underlying pages stay cached.
            </p>
          </div>
          <StatusBadge label={summary.ready ? "Ready" : "Watch"} tone={summary.ready ? "positive" : "warning"} />
        </div>
        <div className="grid gap-3 md:grid-cols-3 xl:grid-cols-6">
          <SummaryPill label="Users" value={summary.users} />
          <SummaryPill label="Facilities" value={summary.facilities} />
          <SummaryPill label="Email lists" value={summary.emailLists} />
          <SummaryPill label="Damage" value={summary.damage} />
          <SummaryPill label="RSA" value={summary.rsa} />
          <SummaryPill label="Health" value={summary.health} />
        </div>
      </div>

      <div className="border-b border-slate-200 dark:border-slate-800">
        <nav className="-mb-px flex space-x-8" aria-label="Tabs">
          {TABS.map((tab) => (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={`
                group inline-flex items-center gap-2 border-b-2 py-4 px-1 text-sm font-bold uppercase tracking-wider transition-colors
                ${activeTab === tab.id 
                  ? "border-[#064e3b] text-[#064e3b] dark:border-cyan-400 dark:text-cyan-400" 
                  : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700 dark:text-slate-400 dark:hover:border-slate-700 dark:hover:text-slate-300"}
              `}
            >
              {tab.icon}
              {tab.label}
            </button>
          ))}
        </nav>
      </div>

      <div className="flex-1 w-full animate-in fade-in duration-300">
        {activeTab === "overview" && <OverviewTab />}
        {activeTab === "reports" && <ReportsTab />}
        {activeTab === "email" && <EmailTab />}
        {activeTab === "orgs" && <OrganizationsTab />}
        {activeTab === "operations" && <OperationsTab />}
      </div>
    </div>
  );
}

function SummaryPill({ label, value }: { label: string; value: string | number }) {
  return (
    <div className="rounded-2xl border border-slate-200/70 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-900/70">
      <p className="text-[10px] font-black uppercase tracking-[0.38em] text-slate-400">{label}</p>
      <p className="mt-1 text-lg font-black text-slate-900 dark:text-white">{value}</p>
    </div>
  );
}

function OverviewTab() {
  return (
    <div className="grid gap-4 xl:grid-cols-2">
      <ActionCard
        href="/control/overview"
        icon={<Activity className="w-5 h-5 text-emerald-500" />}
        title="Deep Overview"
        description="Health, attention items, audit signals, and cross-surface control snapshots."
      />
      <ActionCard
        href="/control/entities"
        icon={<Database className="w-5 h-5 text-cyan-500" />}
        title="Entity Explorer"
        description="Browse users, facilities, damage reports, RSA items, and YMS vehicles in one dense table."
      />
    </div>
  );
}

function ReportsTab() {
  return <SurfaceGrid items={[
    { href: "/control/reports", icon: <History className="w-5 h-5 text-indigo-500" />, title: "Submission Command Center", description: "Inspect report state, anomalies, email linkage, and operator actions." },
    { href: "/control/exceptions", icon: <FileSearch className="w-5 h-5 text-emerald-500" />, title: "Exception Queue", description: "Open damage, unresolved RSA, and stale vehicle signals." },
    { href: "/control/entities", icon: <Eye className="w-5 h-5 text-sky-500" />, title: "Entity Explorer", description: "Search the operational ledger by user, VIN, report, or facility." },
  ]} />;
}

function EmailTab() {
  return <SurfaceGrid items={[
    { href: "/control/email", icon: <Mailbox className="w-5 h-5 text-blue-500" />, title: "Outbound Queue", description: "Queued, failed, and delivered items with retry controls." },
    { href: "/delivery-rules", icon: <LayoutTemplate className="w-5 h-5 text-rose-500" />, title: "Delivery Rules", description: "Notification lists, audience routing, and operational defaults." },
    { href: "/control/templates", icon: <SlidersHorizontal className="w-5 h-5 text-slate-500" />, title: "Templates & Policy", description: "Read-only template snapshot and branding-linked state." },
  ]} />;
}

function OrganizationsTab() {
  return <SurfaceGrid items={[
    { href: "/control/organizations", icon: <Building2 className="w-5 h-5 text-slate-600" />, title: "Organization Catalog", description: "Tenant registry, user counts, and org-level health state." },
    { href: "/users", icon: <Users className="w-5 h-5 text-slate-600" />, title: "Users", description: "Shared directory cache for user and facility state." },
    { href: "/facilities", icon: <Settings2 className="w-5 h-5 text-slate-600" />, title: "Facilities", description: "Operational sites and local registry detail." },
  ]} />;
}

function OperationsTab() {
  return <SurfaceGrid items={[
    { href: "/control/operations", icon: <Settings2 className="w-5 h-5 text-slate-600" />, title: "Manual Job Runner", description: "Release history and current operational posture." },
    { href: "/control/backup", icon: <Database className="w-5 h-5 text-cyan-600" />, title: "System Backups", description: "Backup health and archive history." },
    { href: "/control/exceptions", icon: <AlertTriangle className="w-5 h-5 text-amber-500" />, title: "Exception Monitors", description: "Operator review queue for current failures and stale signals." },
    { href: "/control/flags", icon: <Flag className="w-5 h-5 text-orange-500" />, title: "Global Feature Flags", description: "Flighting and rollout surfaces." },
    { href: "/control/integrations", icon: <Webhook className="w-5 h-5 text-fuchsia-500" />, title: "Integrations & Webhooks", description: "Connector settings and trust-boundary signals." },
    { href: "/control/settings", icon: <SlidersHorizontal className="w-5 h-5 text-slate-500" />, title: "Global Parameters", description: "Settings and cached layout preferences." },
  ]} />;
}

function SurfaceGrid({ items }: { items: Array<{ href: string; icon: ReactNode; title: string; description: string }> }) {
  return (
    <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {items.map((item) => (
        <ActionCard key={item.href} {...item} />
      ))}
    </div>
  );
}

function ActionCard({ href, icon, title, description }: { href: string, icon: ReactNode, title: string, description: string }) {
  return (
    <Link 
      href={href}
      className="group flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-[#064e3b] hover:shadow-md dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-cyan-500/50 dark:hover:bg-slate-900"
    >
      <div>
        <div className="mb-4 flex items-center justify-between">
          <div className="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-slate-50 dark:bg-slate-800">
            {icon}
          </div>
          <ArrowRight className="w-4 h-4 text-slate-300 opacity-0 transition group-hover:-translate-x-1 group-hover:opacity-100 group-hover:text-[#064e3b] dark:group-hover:text-cyan-400" />
        </div>
        <h4 className="text-base font-bold text-slate-900 dark:text-white">{title}</h4>
        <p className="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">{description}</p>
      </div>
      <div className="mt-6 flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-[#064e3b] dark:text-cyan-400">
        Manage Surface
      </div>
    </Link>
  );
}
