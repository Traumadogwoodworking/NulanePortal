"use client";

import { useEffect, useState } from "react";
import { Building2, Search, ArrowUpRight, BarChart3, Users as UsersIcon, Link2 } from "lucide-react";
import { usePortalSession } from "@/lib/portalSession";
import { ControlSection } from "@/components/control/ControlSection";
import { ControlMetricTile } from "@/components/control/ControlMetricTile";
import { DataTableShell } from "@/components/ui/DataTableShell";
import { EmptyState } from "@/components/ui/EmptyState";
import { StatusBadge } from "@/components/ui/StatusBadge";
import { ErrorPanel } from "@/components/ui/ErrorPanel";
import { PortalStatusScreen } from "@/components/PortalStatusScreen";
import { apiFetch } from "@/lib/apiClient";
import { usePortalBrandingSnapshot } from "@/lib/portalData";

export default function OrgsPage() {
  const { session, isSuperAdmin, switchOrganization } = usePortalSession();
  const { data: branding } = usePortalBrandingSnapshot();
  const [orgs, setOrgs] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!isSuperAdmin) {
      setLoading(false);
      return;
    }
    async function load() {
      try {
        const payload = await apiFetch<{ organizations: any[] }>("/admin/organization-list");
        setOrgs(Array.isArray(payload?.organizations) ? payload.organizations : []);
      } catch(e: any) {
        setError(e?.message || "Failed to communicate with control plane.");
      } finally {
        setLoading(false);
      }
    }
    load();
  }, [isSuperAdmin]);

  if (!isSuperAdmin && !loading) {
    return <PortalStatusScreen title="Super-Admin Only" description="Tenant administration requires global administrative privileges." />;
  }

  if (loading) {
    return (
      <div className="animate-pulse space-y-6">
        <div className="h-32 bg-white/5 border border-white/10 rounded-2xl"></div>
        <div className="h-96 bg-white/5 border border-white/10 rounded-2xl"></div>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {error && <ErrorPanel error={error} title="Contract Error" />}
      <ControlSection title="Current org context" description="The live session branding snapshot stays visible while switching tenants.">
        <div className="rounded-[1.5rem] border border-white/10 bg-white/5 p-4 text-sm text-slate-300">
          <p className="font-semibold text-white">{branding?.organization_name || session?.organization?.name || "Unknown organization"}</p>
          <p className="mt-1 text-xs text-slate-400">{session?.organization?.organization_id || "No session org id"}</p>
        </div>
      </ControlSection>

      <div className="grid gap-4 md:grid-cols-4">
        <ControlMetricTile
          label="Total Tenants"
          value={orgs.length}
          detail="Managed organizations"
          icon={<Building2 className="w-4 h-4" />}
        />
        <ControlMetricTile
          label="Active Users"
          value={orgs.reduce((acc, o) => acc + o.users, 0)}
          detail="Across all tenants"
          icon={<UsersIcon className="w-4 h-4" />}
        />
        <ControlMetricTile
          label="Aggregate Facilities"
          value={orgs.reduce((acc, o) => acc + o.facilities, 0)}
          detail="Active connected yards"
          icon={<Link2 className="w-4 h-4" />}
        />
        <ControlMetricTile
          label="Flagged Payload"
          value={orgs.reduce((acc, o) => acc + o.flags, 0)}
          detail="Awaiting review"
          tone="warning"
          icon={<BarChart3 className="w-4 h-4" />}
        />
      </div>

      <ControlSection title="Global admin scope" description="This surface is reserved for super_admin identities and shows the global tenant inventory.">
        <div className="rounded-[1.5rem] border border-white/10 bg-white/5 p-4 text-sm text-slate-300">
          <p className="font-semibold text-white">{branding?.organization_name || session?.organization?.name || "Unknown organization"}</p>
          <p className="mt-1 text-xs text-slate-400">Global organization management only. Org admins remain scoped to their own tenant surfaces.</p>
        </div>
      </ControlSection>

      <ControlSection title="Provisioned Organizations" description="Root tenants and isolated bounds currently active in the ecosystem.">
        <div className="overflow-hidden rounded-[1.5rem] border border-white/10 bg-slate-950/40">
          <DataTableShell
            columns={[
              { id: "name", label: "Organization Name" },
              { id: "tenant", label: "Tenant ID" },
              { id: "users", label: "Users" },
              { id: "status", label: "Health" },
              { id: "actions", label: "" },
            ]}
            rowsCount={orgs.length}
          >
            {orgs.map((org) => (
              <tr key={org.id} className="border-b border-white/5 hover:bg-white/5 transition-colors group">
                <td className="px-4 py-4 text-sm font-medium text-slate-200">
                  {org.name}
                </td>
                <td className="px-4 py-4 text-sm font-mono text-cyan-200">{org.id}</td>
                <td className="px-4 py-4 text-sm text-slate-400">
                  {org.users} <span className="text-slate-600">seated</span>
                </td>
                <td className="px-4 py-4">
                  <StatusBadge 
                    label={org.status} 
                    tone={org.status === "healthy" ? "positive" : "warning"} 
                  />
                </td>
                <td className="px-4 py-4 text-right">
                  <button 
                    className="text-slate-400 hover:text-white p-2" 
                    title="Inspect Tenant Data"
                    onClick={() => switchOrganization(org.id, org.name)}
                  >
                    <ArrowUpRight className="w-4 h-4" />
                  </button>
                </td>
              </tr>
            ))}
          </DataTableShell>
        </div>
        {!orgs.length ? (
          <div className="rounded-[1.5rem] border border-white/10 bg-slate-950/60 p-12">
            <EmptyState title="No organizations returned" description="The backend organization list is empty for this scope." />
          </div>
        ) : null}
      </ControlSection>
    </div>
  );
}
