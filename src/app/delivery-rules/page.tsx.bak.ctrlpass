"use client";

import { useEffect, useMemo, useState } from "react";
import { PageSection } from "@/components/ui/PageSection";
import { DataTableShell } from "@/components/ui/DataTableShell";
import { StatusBadge } from "@/components/ui/StatusBadge";
import { EmptyState } from "@/components/ui/EmptyState";
import { FacilitySelector } from "@/components/ui/FacilitySelector";
import { StatCard } from "@/components/ui/StatCard";
import {
  updateEmailList,
  addEmailListMember,
} from "@/lib/services/notificationsService";
import { usePortalSession } from "@/lib/portalSession";
import { usePortalDirectorySnapshot, usePortalEmailListMembers } from "@/lib/portalData";
import { Bell, Users, Settings2, Search, RefreshCw, ChevronRight } from "lucide-react";
import type { EmailListMemberSummary, EmailListSummary, FacilitySummary } from "@/lib/types";

const STATUS_COLUMNS = ["Delivery Rule", "Type", "Operational Entity", "State"];

const typeTone: Record<string, "positive" | "warning" | "danger" | "neutral"> = {
  notification: "positive",
  alert: "warning",
  "status-update": "neutral",
  default: "neutral",
};

export default function DeliveryRulesPage() {
  const { organizationId } = usePortalSession();
  const { data: directory, mutate: refreshDirectory, isLoading, error } = usePortalDirectorySnapshot();
  const emailLists = directory?.emailLists ?? [];
  const [selectedListId, setSelectedListId] = useState<string | null>(null);
  const [searchTerm, setSearchTerm] = useState("");
  const [facilityFilter, setFacilityFilter] = useState<string>("all");
  const [statusMessage, setStatusMessage] = useState<string | null>(null);
  const [operationMessage, setOperationMessage] = useState<string | null>(null);
  const { data: members = [] } = usePortalEmailListMembers(selectedListId);
  const facilities = directory?.facilities ?? [];

  const facilityLookup = useMemo(() => {
    return facilities.reduce<Record<string, FacilitySummary>>((acc, facility) => {
      acc[facility.id] = facility;
      return acc;
    }, {});
  }, [facilities]);

  const stats = useMemo(() => ([
    { label: "Active Rules", value: emailLists.filter(l => l.is_active !== false).length, detail: "Delivery Triggers" },
    { label: "Total Members", value: members.length || "...", detail: "Audience Reach" },
    { label: "Regional Nodes", value: facilities.length, detail: "Facility Scopes" },
  ]), [emailLists, members, facilities]);

  const loadLists = async () => {
    setStatusMessage(null);
    await refreshDirectory();
  };

  const filteredLists = useMemo(() => {
    const query = searchTerm.trim().toLowerCase();
    const facilityConstraint = facilityFilter !== "all";
    return emailLists.filter((list) => {
      const matchesQuery =
        !query ||
        list.list_name.toLowerCase().includes(query) ||
        (list.list_key || "").toLowerCase().includes(query);
      if (!matchesQuery) {
        return false;
      }
      if (facilityConstraint) {
        return list.location_id === facilityFilter;
      }
      return true;
    });
  }, [emailLists, searchTerm, facilityFilter]);

  const selectedList =
    filteredLists.find((list) => list.email_list_id === selectedListId) ??
    filteredLists[0] ??
    null;

  useEffect(() => {
    if (!filteredLists.length) {
      setSelectedListId(null);
      return;
    }
    if (!filteredLists.some((list) => list.email_list_id === selectedListId)) {
      setSelectedListId(filteredLists[0].email_list_id);
    }
  }, [filteredLists, selectedListId]);

  const showEmptyState = !filteredLists.length && !isLoading && !statusMessage;

  if (error) {
    return <EmptyState title="Routing Error" description={error instanceof Error ? error.message : "Unable to load delivery rules."} />;
  }

  const toggleListStatus = async () => {
    if (!organizationId || !selectedList) {
      setOperationMessage("Select a rule to update.");
      return;
    }
    setOperationMessage(null);
    try {
      await updateEmailList(organizationId, selectedList.email_list_id, {
        is_active: !selectedList.is_active,
      });
      setOperationMessage(
        `Rule ${selectedList.is_active === false ? "synchronized" : "hibernated"}.`
      );
      await loadLists();
    } catch (error) {
      setOperationMessage(
        error instanceof Error ? error.message : "Synchronization link failed."
      );
    }
  };

  const addMemberToList = async () => {
    if (!organizationId || !selectedList) {
      setOperationMessage("Select a rule targeting membership.");
      return;
    }
    const email = window.prompt("Enter member registry email");
    if (!email) {
      return;
    }
    setOperationMessage(null);
    try {
      await addEmailListMember(organizationId, selectedList.email_list_id, {
        email,
        display_name: email,
      });
      setOperationMessage("Subscriber provisioned.");
      await loadLists();
    } catch (error) {
      setOperationMessage(
        error instanceof Error ? error.message : "Provisioning error."
      );
    }
  };

  if (!organizationId) {
    return (
      <EmptyState
        title="Context Bridge Unavailable"
        description="Establish an organization session to verify notification routing."
      />
    );
  }

  return (
    <article className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-3 gap-2">
        {stats.map(s => (
          <StatCard key={s.label} label={s.label} value={s.value} detail={s.detail} />
        ))}
      </div>

       <PageSection
        title="Delivery Rules"
        description="Configure CC, BCC, triggers, and automated report delivery behavior."
        variant="panel"
        actions={
          <div className="flex flex-wrap items-center gap-2">
            <div className="relative group">
               <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 group-focus-within:text-brand transition-colors" />
               <input
                 type="search"
                 placeholder="Search registry..."
                 value={searchTerm}
                 onChange={(e) => setSearchTerm(e.target.value)}
                 className="w-48 pl-8 pr-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-[11px] font-bold text-slate-900 dark:text-white placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-brand/40 transition-all shadow-sm"
               />
            </div>
            <FacilitySelector
              facilities={facilities}
              value={facilityFilter}
              onChange={setFacilityFilter}
            />
            <button
              onClick={() => void loadLists()}
              className="p-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-500 hover:text-brand transition-all shadow-sm"
            >
              <RefreshCw className={`w-3.5 h-3.5 ${isLoading ? 'animate-spin' : ''}`} />
            </button>
          </div>
        }
      >
        {isLoading || statusMessage ? (
          <div className="space-y-4">
            {statusMessage && (
              <EmptyState title="Routing Error" description={statusMessage} />
            )}
            {isLoading && (
              <div className="py-20 flex justify-center"><RefreshCw className="animate-spin text-brand/40" /></div>
            )}
          </div>
        ) : showEmptyState ? (
          <EmptyState title="No Rules Active" description="No active routing rules found in the current environment." />
        ) : (
          <div className="grid gap-4 lg:grid-cols-[2fr,1fr]">
            <div className="-mx-4 -mb-4">
              <DataTableShell columns={STATUS_COLUMNS}>
                {filteredLists.map((list) => {
                  const facilityName = facilityLookup[list.location_id || ""]?.name || "Global Instance";
                  const tone = typeTone[list.list_type || "default"] || typeTone.default;
                  const isSelected = list.email_list_id === selectedList?.email_list_id;
                  return (
                    <tr
                      key={list.email_list_id}
                      onClick={() => setSelectedListId(list.email_list_id)}
                      className={`group transition-all duration-150 cursor-pointer ${
                        isSelected ? "bg-brand/[0.03] dark:bg-brand/10" : "hover:bg-slate-50 dark:hover:bg-slate-900/40"
                      }`}
                    >
                      <td className="px-4 py-3">
                         <div className="flex items-center gap-3">
                            <div className={`w-7 h-7 rounded bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 ${isSelected ? 'text-brand' : ''}`}>
                               <Bell className="w-3.5 h-3.5" />
                            </div>
                            <div className="flex flex-col min-w-0">
                               <span className={`text-xs font-bold truncate ${isSelected ? 'text-brand' : 'text-slate-900 dark:text-white'}`}>{list.list_name}</span>
                               <span className="text-[10px] text-slate-500 font-bold uppercase tracking-tight truncate">{list.list_key}</span>
                            </div>
                         </div>
                      </td>
                      <td className="px-4 py-3">
                        <StatusBadge label={list.list_type || "Standard"} tone={tone} />
                      </td>
                      <td className="px-4 py-3 text-[11px] font-bold text-slate-600 dark:text-slate-400 uppercase tracking-widest">{facilityName}</td>
                      <td className="px-4 py-3">
                        <StatusBadge
                          label={list.is_active === false ? "Dormant" : "Operational"}
                          tone={list.is_active === false ? "danger" : "positive"}
                        />
                      </td>
                    </tr>
                  );
                })}
              </DataTableShell>
            </div>

            <aside className="lg:border-l border-slate-100 dark:border-slate-800 pl-4 py-2">
                <div className="sticky top-4 space-y-6">
                    {selectedList ? (
                        <>
                            <header className="space-y-4">
                                <div className="flex items-center gap-3">
                                    <div className="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center shadow-inner">
                                        <Settings2 className="w-5 h-5" />
                                    </div>
                                    <div className="min-w-0">
                                        <h3 className="text-[14px] font-black text-slate-950 dark:text-white leading-none truncate uppercase tracking-tight">{selectedList.list_name}</h3>
                                        <p className="text-[10px] text-slate-500 font-bold mt-1 uppercase tracking-widest">{selectedList.list_key}</p>
                                    </div>
                                </div>
                                <div className="flex gap-1.5 font-bold">
                                    <StatusBadge label={selectedList.list_type || "Rule"} tone="neutral" />
                                    <StatusBadge label={selectedList.is_active === false ? "Sync: Paused" : "Sync: Live"} tone={selectedList.is_active === false ? "danger" : "positive"} />
                                </div>
                            </header>

                            <div className="space-y-6">
                                <section className="space-y-2">
                                    <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Subscriber Registry</p>
                                    <div className="space-y-1.5 max-h-[300px] overflow-y-auto pr-1 custom-scrollbar">
                                        {members.length ? members.map(m => (
                                            <div key={m.email_list_member_id} className="p-3 rounded-xl bg-slate-50/80 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex items-center justify-between group">
                                               <div className="min-w-0">
                                                    <p className="text-[11px] font-bold text-slate-950 dark:text-white truncate">{m.display_name || m.email}</p>
                                                    <p className="text-[9px] text-slate-500 font-medium uppercase tracking-tight ">{m.member_type || "external"}</p>
                                               </div>
                                               <div className={`w-1.5 h-1.5 rounded-full ${m.is_active === false ? 'bg-slate-300' : 'bg-brand'}`}></div>
                                            </div>
                                        )) : <p className="text-[10px] text-slate-400 font-bold uppercase p-4 text-center border border-dashed border-slate-200 dark:border-slate-800 rounded-xl">Empty Registry</p>}
                                    </div>
                                </section>

                                <nav className="space-y-4">
                                     <div className="space-y-2">
                                         <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Logic Rules</p>
                                         <div className="p-3 rounded-xl bg-slate-900 text-white font-mono text-[9px] border border-white/5 opacity-80">
                                             <p className="text-emerald-500/60 transition-colors group-hover:text-emerald-500">{"// Context metadata"}</p>
                                             <p className="mt-1">{selectedList.metadata?.description || "No supplemental logic."}</p>
                                         </div>
                                     </div>
                                </nav>
                            </div>

                            <footer className="space-y-2 pt-2">
                                <button 
                                    onClick={addMemberToList}
                                    className="w-full flex items-center justify-between p-2.5 rounded-lg bg-brand text-white text-[10px] font-black uppercase tracking-widest shadow-lg shadow-brand/10 hover:brightness-110 active:scale-95 transition-all"
                                >
                                    Provision Subscriber
                                    <Users className="w-3.5 h-3.5" />
                                </button>
                                <button 
                                    onClick={toggleListStatus}
                                    className={`w-full flex items-center justify-between p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-[10px] font-black uppercase tracking-widest transition-all ${selectedList.is_active === false ? 'bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white' : 'text-slate-400 hover:text-rose-500'}`}
                                >
                                    {selectedList.is_active === false ? "Restore Rule" : "Suspend Bridge"}
                                    <ChevronRight className="w-3.5 h-3.5" />
                                </button>
                                {operationMessage && (
                                    <div className="mt-2 p-2 rounded-lg bg-brand/5 border border-brand/10 text-[9px] font-black text-brand uppercase tracking-widest text-center animate-in fade-in zoom-in-95">
                                        {operationMessage}
                                    </div>
                                )}
                            </footer>
                        </>
                    ) : (
                        <div className="py-20 text-center space-y-4">
                            <div className="w-12 h-12 rounded-full bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-300 mx-auto">
                                <Bell className="w-5 h-5" />
                            </div>
                            <p className="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Select delivery rule</p>
                        </div>
                    )}
                </div>
            </aside>
          </div>
        )}
      </PageSection>
    </article>
  );
}
