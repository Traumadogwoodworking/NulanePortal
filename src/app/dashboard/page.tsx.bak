"use client";

import { useState } from "react";
import { usePortalSession } from "@/lib/portalSession";
import { getPortalBranding } from "@/lib/branding";
import { PowerBiEmbed } from "@/components/PowerBiEmbed";

// Mock local registry for future config/backend dynamic rendering
const DASHBOARD_REGISTRY = [
  { id: "fleet-health", label: "Fleet Health Overview" },
  { id: "rsa-metrics", label: "RSA Vendor Metrics" },
  { id: "damage-trends", label: "Damage Assessment Trends" }
];

export default function DashboardPage() {
  const { session } = usePortalSession();
  const branding = session ? getPortalBranding(session) : null;
  const powerBiUrl = branding?.powerBiEmbedUrl;
  
  const [activeDashboard, setActiveDashboard] = useState(DASHBOARD_REGISTRY[0].id);

  return (
    <article className="h-full min-h-[calc(100vh-80px)] flex flex-col px-6 lg:px-10 py-6">
      <header className="mb-6 flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
        <div>
          <p className="text-[11px] font-black uppercase tracking-[0.4em] text-slate-400">Intelligence</p>
          <h1 className="text-3xl font-black text-slate-900">Dashboards</h1>
          <p className="text-sm text-slate-500 max-w-3xl mt-2 leading-relaxed">
            Embedded Power BI operational analytics. Select a dashboard context from your organizations&apos; authorized workspaces.
          </p>
        </div>
        
        {/* Dashboard Selector Carousel/Tabs */}
        <div className="flex flex-wrap items-center bg-slate-100/80 p-1.5 rounded-xl border border-slate-200/60 shadow-inner">
          {DASHBOARD_REGISTRY.map(dash => (
            <button
              key={dash.id}
              onClick={() => setActiveDashboard(dash.id)}
              className={`px-4 py-2 text-sm font-bold transition-all rounded-lg ${
                activeDashboard === dash.id 
                  ? "bg-white text-slate-900 shadow-sm border border-slate-200/50" 
                  : "text-slate-500 hover:text-slate-700 hover:bg-slate-200/50"
              }`}
            >
              {dash.label}
            </button>
          ))}
        </div>
      </header>

      <section className="flex-1 relative min-h-[700px] w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        {powerBiUrl ? (
          <PowerBiEmbed embedUrl={powerBiUrl} organizationName={branding?.organizationName || "Unknown"} />
        ) : (
          <div className="flex h-full min-h-[700px] w-full flex-col items-center justify-center bg-white p-6 text-center">
            <div className="mb-6 flex h-20 w-20 items-center justify-center rounded-full border border-slate-200 bg-slate-100 shadow-sm">
              <span className="text-3xl">📊</span>
            </div>
            <h3 className="text-xl font-black text-slate-900">Power BI Not Configured</h3>
            <p className="text-slate-500 max-w-md mt-3 leading-relaxed">
              The active organization does not have a Power BI embed token assigned. 
              Configure the tenant settings to link a valid workspace or contact a system administrator.
            </p>
          </div>
        )}
      </section>
    </article>
  );
}
