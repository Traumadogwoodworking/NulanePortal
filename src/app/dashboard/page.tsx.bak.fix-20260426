"use client";

import { usePortalSession } from "@/lib/portalSession";
import { getPortalBranding } from "@/lib/branding";
import { PowerBiEmbed } from "@/components/PowerBiEmbed";
import { EmptyState } from "@/components/ui/EmptyState";
import { redirectToAuth0Login } from "@/lib/portalAuth";

export default function DashboardPage() {
  const { session, status } = usePortalSession();
  const branding = session ? getPortalBranding(session) : null;
  const powerBiUrl = branding?.powerBiEmbedUrl ?? null;

  if (status === "loading") {
    return (
      <article className="flex min-h-[calc(100vh-80px)] flex-col px-6 py-6 lg:px-10">
        <div className="rounded-[1.75rem] border border-slate-200 bg-white p-8 text-center shadow-sm">
          <p className="text-[10px] font-black uppercase tracking-[0.4em] text-slate-400">Dashboards</p>
          <h1 className="mt-3 text-3xl font-black text-slate-900">Loading session</h1>
          <p className="mt-2 text-sm text-slate-500">Checking sign-in state and brand configuration.</p>
        </div>
      </article>
    );
  }

  if (status === "unauthenticated") {
    return (
      <article className="flex min-h-[calc(100vh-80px)] flex-col px-6 py-6 lg:px-10">
        <div className="flex flex-1 items-center justify-center">
          <EmptyState
            title="Sign in to open dashboards"
            description="This page needs an authenticated portal session before it can load the embedded analytics."
            action={
              <button
                type="button"
                onClick={async () => {
                  await redirectToAuth0Login("/dashboard");
                }}
                className="inline-flex items-center justify-center rounded-full bg-slate-900 px-4 py-2 text-[11px] font-black uppercase tracking-[0.28em] text-white transition hover:bg-slate-800"
              >
                Log in
              </button>
            }
          />
        </div>
      </article>
    );
  }

  return (
    <article className="h-full min-h-[calc(100vh-80px)] flex flex-col px-6 lg:px-10 py-6">
      <header className="mb-6 flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
        <div>
          <p className="text-[11px] font-black uppercase tracking-[0.4em] text-slate-400">Intelligence</p>
          <h1 className="text-3xl font-black text-slate-900">Dashboards</h1>
          <p className="text-sm text-slate-500 max-w-3xl mt-2 leading-relaxed">
            Organization-approved operational analytics. If no embed is configured, the page shows a clear setup state instead of a blank frame.
          </p>
        </div>
        <div className="inline-flex items-center gap-2 rounded-xl border border-slate-200/60 bg-slate-50/80 px-4 py-3 text-xs font-bold uppercase tracking-widest text-slate-500 shadow-inner">
          {powerBiUrl ? "Power BI configured" : "Embed not configured"}
        </div>
      </header>

      <section className="flex-1 relative min-h-[560px] w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        {powerBiUrl ? (
          <PowerBiEmbed
            embedUrl={powerBiUrl}
            organizationName={branding?.organizationName || "Unknown"}
          />
        ) : (
          <div className="flex min-h-[560px] items-center justify-center p-6">
            <EmptyState
              title="Dashboard embed not configured"
              description="This organization does not currently expose an approved Power BI embed URL to the portal."
            />
          </div>
        )}
      </section>
    </article>
  );
}
