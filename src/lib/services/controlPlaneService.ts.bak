}

function toIsoString(value: unknown): string | null {
  if (typeof value !== "string") {
    return null;
  }
  const parsed = Date.parse(value);
  return Number.isNaN(parsed) ? null : new Date(parsed).toISOString();
}

async function fetchJson<T>(path: string): Promise<T> {
  const response = await fetch(buildApiUrl(path), {
    cache: "no-store",
    headers: {
      "Content-Type": "application/json",
    },
  });
  const payload = (await response.json().catch(() => null)) as T | null;
  if (!response.ok) {
    const message =
      payload && typeof payload === "object" && "error" in payload && typeof (payload as { error?: unknown }).error === "string"
        ? (payload as { error: string }).error
        : `Request failed with ${response.status}`;
    throw new Error(message);
  }
  if (!payload) {
    throw new Error("Empty response from control-plane endpoint");
  }
  return payload;
}

async function fetchControlJson<T>(path: string): Promise<T> {
  return fetchJson<T>(path);
}

export async function fetchOperationsStatus(): Promise<ControlOperationsStatus> {
  return fetchControlJson<ControlOperationsStatus>("/status");
}

export async function fetchReadinessStatus(): Promise<ControlReadyzStatus> {
  return fetchControlJson<ControlReadyzStatus>("/readyz");
}

export async function fetchYmsVehicles(): Promise<YmsVehicleSummary[]> {
  const payload = await apiFetch<{ vehicles: YmsVehicleSummary[] }>("/yms/vehicles");
  return Array.isArray(payload?.vehicles) ? payload.vehicles : [];
}

export async function fetchYmsYardState(): Promise<YmsYardStateResponse> {
  const payload = await apiFetch<YmsYardStateResponse>("/yms/yard-state");
  return {
    summary: payload?.summary ?? { yards: 0, zones: 0, slots: 0, occupiedSlots: 0 },
    yards: Array.isArray(payload?.yards) ? payload.yards : [],
    scope: payload?.scope,
    data_source: payload?.data_source,
  };
}

export async function fetchYmsAssignments(): Promise<YmsAssignmentSummary[]> {
  const payload = await apiFetch<{ assignments: YmsAssignmentSummary[] }>("/yms/assignments");
  return Array.isArray(payload?.assignments) ? payload.assignments : [];
}

export async function fetchYmsVehicleDetail(vin: string): Promise<YmsVehicleDetail | null> {
  if (!vin) {
    return null;
  }
  const payload = await apiFetch<YmsVehicleDetail>(`/yms/vin/${encodeURIComponent(vin)}`);
  return payload ?? null;
}

export async function fetchYmsMapForYard(
  yardId: string,
  zoneId?: string | null
): Promise<YmsMapResponse | null> {
  if (!yardId) {
    return null;
  }
  const query = new URLSearchParams({ yard_id: yardId });
  if (zoneId) {
    query.set("zone_id", zoneId);
  }
  const payload = await apiFetch<YmsMapResponse>(`/yms/map?${query.toString()}`);
  return payload ?? null;
}

export async function fetchYmsMapZones(yardId: string): Promise<Record<string, unknown>[]> {
  if (!yardId) {
    return [];
  }
  const payload = await apiFetch<{ map: Record<string, unknown>[] }>(`/yms/map/zones?yard_id=${encodeURIComponent(yardId)}`);
  return Array.isArray(payload?.map) ? payload.map : [];
}

