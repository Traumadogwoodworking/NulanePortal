export async function fetchOrganizationBranding(organizationId: string): Promise<BrandingSnapshot> {
  if (!organizationId) {
    return {};
  }
  return apiFetch<BrandingSnapshot>(`/organizations/${encodeURIComponent(organizationId)}/branding`);
}

export async function fetchAdminSettings(): Promise<ControlSettingRecord[]> {
  const payload = await apiFetch<{ settings: ControlSettingRecord[] }>("/admin/settings");
  return Array.isArray(payload?.settings) ? payload.settings : [];
}

function buildAdminOutboxQuery(params: Record<string, string | number | boolean | undefined | null>) {
  const query = new URLSearchParams();
  Object.entries(params).forEach(([key, value]) => {
    if (value === undefined || value === null || value === "") {
      return;
    }
    query.set(key, String(value));
  });
  const suffix = query.toString();
  return suffix ? `?${suffix}` : "";
}

export async function fetchAdminOutbox(
  organizationId?: string,
  filters: {
    status?: string;
    templateKey?: string;
    failedOnly?: boolean;
    search?: string;
    limit?: number;
    offset?: number;
  } = {},
): Promise<ControlOutboxListResponse> {
  const path = `/admin/outbox${buildAdminOutboxQuery({
    organizationId,
    status: filters.status,
    template_key: filters.templateKey,
    failedOnly: filters.failedOnly,
    q: filters.search,
    limit: filters.limit,
    offset: filters.offset,
  })}`;
  return apiFetch<ControlOutboxListResponse>(path);
}

export async function fetchAdminOutboxItem(
  id: string,
  organizationId?: string,
): Promise<ControlOutboxItem | null> {
  if (!id) {
    return null;
  }
  const path = `/admin/outbox/${encodeURIComponent(id)}${buildAdminOutboxQuery({ organizationId })}`;
  const payload = await apiFetch<{ outbox: ControlOutboxItem }>(path);
  return payload?.outbox ?? null;
}

export async function fetchAdminOutboxHistory(
  id: string,
  organizationId?: string,
): Promise<ControlOutboxHistoryItem[]> {
  if (!id) {
    return [];
  }
  const path = `/admin/outbox/${encodeURIComponent(id)}/history${buildAdminOutboxQuery({ organizationId })}`;
  const payload = await apiFetch<{ history: ControlOutboxHistoryItem[] }>(path);
  return Array.isArray(payload?.history) ? payload.history : [];
}

export async function retryAdminOutbox(
  id: string,
  organizationId?: string,
  reason?: string,
): Promise<ControlOutboxItem | null> {
  if (!id) {
    return null;
  }
  const path = `/admin/outbox/${encodeURIComponent(id)}/retry${buildAdminOutboxQuery({ organizationId })}`;
  const payload = await apiFetch<{ outbox: ControlOutboxItem }>(path, {
    method: "POST",
    body: JSON.stringify({ reason }),
  });
  return payload?.outbox ?? null;
}

export async function resendAdminOutbox(
  id: string,
  organizationId?: string,
  reason?: string,
): Promise<ControlOutboxItem | null> {
  if (!id) {
    return null;
  }
  const path = `/admin/outbox/${encodeURIComponent(id)}/resend${buildAdminOutboxQuery({ organizationId })}`;
  const payload = await apiFetch<{ outbox: ControlOutboxItem }>(path, {
    method: "POST",
    body: JSON.stringify({ reason }),
  });
  return payload?.outbox ?? null;
}

export function normalizeControlTimestamp(value?: string | null): string {
  const iso = toIsoString(value);
  if (!iso) {
    return "Unknown";
  }
  return new Date(iso).toLocaleString();
}

export function isOlderThanHours(value?: string | null, hours = 2): boolean {
  if (!value) {
    return true;
  }
  const parsed = Date.parse(value);
  if (Number.isNaN(parsed)) {
    return true;
  }
  const elapsedMs = Date.now() - parsed;
  return elapsedMs > hours * 60 * 60 * 1000;
}
