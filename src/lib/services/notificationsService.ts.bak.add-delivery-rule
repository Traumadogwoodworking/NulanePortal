import { apiFetch } from "@/lib/apiClient";
import { isDevMockEnabled } from "@/lib/devMockApi";
import {
  EmailListMemberSummary,
  EmailListSummary,
} from "@/lib/types";

const EMAIL_LISTS_ENDPOINT = (organizationId: string) =>
  `/admin/organizations/${organizationId}/email-lists`;
const EMAIL_LIST_DETAIL_ENDPOINT = (organizationId: string, listId: string) =>
  `/admin/organizations/${organizationId}/email-lists/${listId}`;
const EMAIL_LIST_MEMBERS_ENDPOINT = (organizationId: string, listId: string) =>
  `/admin/organizations/${organizationId}/email-lists/${listId}/members`;

export async function fetchEmailLists(organizationId: string): Promise<EmailListSummary[]> {
  if (!organizationId) {
    return [];
  }
  if (isDevMockEnabled()) {
    return [];
  }
  const payload = await apiFetch<{ email_lists: EmailListSummary[] }>(
    EMAIL_LISTS_ENDPOINT(organizationId)
  );
  return Array.isArray(payload?.email_lists) ? payload.email_lists : [];
}

export async function fetchEmailListMembers(
  organizationId: string,
  listId: string
): Promise<EmailListMemberSummary[]> {
  if (!organizationId || !listId) {
    return [];
  }
  if (isDevMockEnabled()) {
    return [];
  }
  const payload = await apiFetch<{ members: EmailListMemberSummary[] }>(
    EMAIL_LIST_MEMBERS_ENDPOINT(organizationId, listId)
  );
  return Array.isArray(payload?.members) ? payload.members : [];
}

export async function updateEmailList(
  organizationId: string,
  listId: string,
  payload: Partial<EmailListSummary>
): Promise<EmailListSummary> {
  return apiFetch<EmailListSummary>(EMAIL_LIST_DETAIL_ENDPOINT(organizationId, listId), {
    method: "PUT",
    body: JSON.stringify(payload),
  });
}

export async function addEmailListMember(
  organizationId: string,
  listId: string,
  payload: {
    email: string;
    display_name?: string;
    member_type?: string;
  }
): Promise<EmailListMemberSummary> {
  return apiFetch<EmailListMemberSummary>(EMAIL_LIST_MEMBERS_ENDPOINT(organizationId, listId), {
    method: "POST",
    body: JSON.stringify(payload),
  });
}

export async function deleteEmailList(
  organizationId: string,
  listId: string
): Promise<{ success: boolean }> {
  return apiFetch<{ success: boolean }>(EMAIL_LIST_DETAIL_ENDPOINT(organizationId, encodeURIComponent(listId)), {
    method: "DELETE",
  });
}

export async function deleteEmailListMember(
  organizationId: string,
  listId: string,
  memberId: string
): Promise<{ success: boolean }> {
  return apiFetch<{ success: boolean }>(
    `${EMAIL_LIST_MEMBERS_ENDPOINT(organizationId, encodeURIComponent(listId))}/${encodeURIComponent(memberId)}`,
    { method: "DELETE" }
  );
}
