import type { PermissionKey } from "./access";
import { isModuleEnabled, ModuleToggleKey } from "@/lib/modules";

export type RouteSectionKey = "core" | "apps" | "settings" | "administration" | "support";

export interface PortalRoute {
  label: string;
  href: string;
  description: string;
  section: RouteSectionKey;
  icon?: string; // SVG key or Emoji
  badge?: string;
  brandColor?: string;
  brandLogo?: string;
  requiresOrgAdmin?: boolean;
  requiredPermission?: PermissionKey;
  requiresAwct?: boolean;
  hideFromNav?: boolean;
  moduleKey?: ModuleToggleKey;
}

export interface PortalNavSection {
  key: RouteSectionKey;
  title: string;
  items: PortalRoute[];
}

