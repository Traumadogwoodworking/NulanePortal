export interface ControlRouteDefinition {
  href: string;
  label: string;
  description: string;
  live?: boolean;
  connectionStatus?: "real" | "mixed" | "mocked" | "placeholder" | "scaffold";
  hideFromNav?: boolean;
  requiresSuperAdmin?: boolean;
}

export const controlRoutes: ControlRouteDefinition[] = [
  {
    href: "/control",
    label: "Control",
    description: "Command center",
    live: true,
    connectionStatus: "mixed",
    hideFromNav: false,
    // System control is global-only.
    // Org admins keep tenant-scoped admin pages outside this hub.
    requiresSuperAdmin: true,
  },
  {
    href: "/control/overview",
    label: "Overview",
