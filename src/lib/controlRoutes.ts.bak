export interface ControlRouteDefinition {
  href: string;
  label: string;
  description: string;
  live?: boolean;
}

export const controlRoutes: ControlRouteDefinition[] = [
  {
    href: "/control",
    label: "Control",
    description: "Command center",
    live: true,
  },
  {
    href: "/control/overview",
    label: "Overview",
    description: "Health and attention",
    live: true,
  },
  {
    href: "/control/entities",
    label: "Entities",
    description: "Search and drill-in",
    live: true,
  },
  {
    href: "/control/vehicles",
    label: "Vehicles",
    description: "Timeline and yard state",
    live: true,
  },
  {
    href: "/control/exceptions",
    label: "Exceptions",
    description: "Derived anomaly queue",
    live: true,
  },
  {
    href: "/control/outbox",
    label: "Outbox",
    description: "Outbound record surface",
  },
  {
    href: "/control/templates",
    label: "Templates",
    description: "Template catalog and usage",
    live: true,
  },
  {
    href: "/control/integrations",
    label: "Integrations",
    description: "Trust boundaries and status",
    live: true,
  },
  {
    href: "/control/map",
    label: "Map",
    description: "Facility and yard context",
    live: true,
  },
  {
    href: "/control/users",
    label: "Users",
    description: "Roles and memberships",
    live: true,
  },
  {
    href: "/control/audit",
    label: "Audit",
    description: "Operator traceability",
    live: true,
  },
  {
    href: "/control/settings",
    label: "Settings",
    description: "Layout and safe prefs",
    live: true,
  },
];

export function isControlRoute(pathname: string): boolean {
  return pathname === "/control" || pathname.startsWith("/control/");
}

export function getControlRouteByPath(pathname: string): ControlRouteDefinition {
  const route = controlRoutes
    .slice()
    .sort((a, b) => b.href.length - a.href.length)
    .find((item) => pathname === item.href || pathname.startsWith(`${item.href}/`));
  return route ?? controlRoutes[0];
}
