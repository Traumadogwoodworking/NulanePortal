{
  "name": "portal-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:perf": "ESLINT_PERF=true eslint --ext .ts,.tsx src",
    "test": "vitest run",
    "ci": "npm run lint && vitest --coverage && playwright test",
    "build:analyze": "ANALYZE=true next build --profile && next-bundle-analyzer --threshold 250 --threshold 350"
  },
  "dependencies": {
    "@types/file-saver": "^2.0.7",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "pdfmake": "^0.3.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.7",
    "@testing-library/jest-dom": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "msw": "^1.2.1",
    "pdfmake-node": "^0.2.32",
    "playwright": "^1.38.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "vitest-axe": "^0.1.0"
  }
}
