# DocuDent portal public build configuration. Values are identifiers and URLs,
# not client secrets. Copy them into the deployment environment; do not commit
# local credentials or Auth0 Management API secrets.
NEXT_PUBLIC_PORTAL_BRANDING=docudent
NEXT_PUBLIC_API_BASE_URL=https://api.nulanesystems.com/api
NEXT_PUBLIC_AUTH0_DOMAIN=nulanesystems.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=WkYT29HkNJo5rjDMPGTxAdb04QdKQsPc
NEXT_PUBLIC_AUTH0_ORGANIZATION_ID=org_cmCOV936fSunCIJB
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.nulanesystems.com
NEXT_PUBLIC_PORTAL_URL=https://docudent-portal.vercel.app
NEXT_PUBLIC_AUTH0_REDIRECT_URI=https://docudent-portal.vercel.app/auth/callback/
NEXT_PUBLIC_AUTH0_REDIRECT_MODE=fixed
# Keep false until the intended DocuDent backend proves the registration,
# membership, role-assignment, and idempotency contract end to end.
NEXT_PUBLIC_DOCUDENT_FACILITY_ONBOARDING_ENABLED=false
