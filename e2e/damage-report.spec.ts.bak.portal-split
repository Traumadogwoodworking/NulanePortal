import { expect, test } from "@playwright/test";
import { configureApiMocks } from "./utils/apiMock";

test("damage report drawer reveals heat map", async ({ page }) => {
  await configureApiMocks(page);
  await page.goto("/reports");
  await expect(page.locator("text=Surface Analysis Assets")).toBeVisible();
  await page.click("text=Atlas Rover");
  const heatMap = page.locator('svg[aria-label="Damage splat chart"]');
  await expect(heatMap).toBeVisible({ timeout: 10000 });
});
