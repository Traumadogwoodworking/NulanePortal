import type { Page, Route } from "@playwright/test";
import measurements from "../../test/fixtures/measurements.json";

const apiBase = "https://api.nulanesystems.com/api";

const textJson = (payload: unknown) =>
  JSON.stringify(payload, (key, value) =>
    typeof value === "object" && value !== null ? value : value
  );

export async function configureApiMocks(page: Page) {
  await page.route(`${apiBase}/**`, async (route: Route) => {
    const url = new URL(route.request().url());
    const path = url.pathname.replace("/api", "");

    if (path.startsWith("/measurements")) {
      const latest = url.searchParams.get("latest");
      const data = latest ? measurements.slice(-10) : measurements;
      return route.fulfill({
        status: 200,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
    }

    if (path.startsWith("/docufit/pdf")) {
      return route.fulfill({ status: 200, headers: { "Content-Type": "application/json" }, body: textJson({ success: true }) });
    }

    if (path.startsWith("/photos/upload")) {
      return route.fulfill({
        status: 200,
        headers: { "Content-Type": "application/json" },
        body: textJson({ photo_urls: ["https://nulanesystems.com/media/mock.png"] }),
      });
    }

    if (path.startsWith("/docufit/uploads")) {
      return route.fulfill({
        status: 200,
        headers: { "Content-Type": "application/json" },
        body: textJson({ upload_id: "mock-upload" }),
      });
    }

    if (path.startsWith("/vin/")) {
      return route.fulfill({
        status: 200,
        headers: { "Content-Type": "application/json" },
        body: textJson({ status: "verified", label: "Verified VIN" }),
      });
    }

    if (path.startsWith("/report/pull")) {
      return route.fulfill({
        status: 200,
        headers: { "Content-Type": "application/json" },
        body: textJson({
          reports: [
            {
              report_id: "damage-001",
              make: "Atlas",
              model: "Rover",
              year: "2025",
              vin: "1HGCM82633A004352",
              status: "open",
              inspector_email: "ops@example.com",
              damage_entries: [],
              splat_urls: [],
            },
          ],
        }),
      });
    }

    if (path.startsWith("/reports/rsa")) {
      return route.fulfill({ status: 200, headers: { "Content-Type": "application/json" }, body: textJson({ reports: [] }) });
    }

    return route.continue();
  });
}
