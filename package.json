{
  "name": "portal-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-native-deps.mjs",
    "dev": "next dev --webpack --port 3000",
    "prebuild": "node scripts/verify-definian-release-identity.mjs --if-production && node scripts/ensure-native-deps.mjs",
    "build": "next build",
    "export:finalize": "node scripts/finalize-static-export.mjs",
    "export:validate": "node scripts/validate-static-export.mjs",
    "release:preflight": "node scripts/verify-definian-release-identity.mjs --require-env --require-clean",
    "start": "npx serve@latest out",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:perf": "ESLINT_PERF=true eslint --ext .ts,.tsx src",
    "test": "vitest run",
    "ci": "npm run lint && vitest --coverage && playwright test",
    "ci:static": "npm run build && npm run export:finalize && npm run export:validate",
    "build:analyze": "ANALYZE=true next build --profile && next-bundle-analyzer --threshold 250 --threshold 350"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.22.0",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@types/file-saver": "^2.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "^20.19.43",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.0.1",
    "msw": "^2.14.6",
    "pdfmake-node": "^0.2.32",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
