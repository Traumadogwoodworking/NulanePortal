{
  "name": "portal-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-native-deps.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/ensure-native-deps.mjs",
    "build": "next build",
    "export:validate": "node scripts/validate-static-export.mjs",
    "start": "npx serve@latest out",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:perf": "ESLINT_PERF=true eslint --ext .ts,.tsx src",
    "test": "vitest run",
    "ci": "npm run lint && vitest --coverage && playwright test",
    "ci:static": "npm run build && npm run export:validate",
    "build:analyze": "ANALYZE=true next build --profile && next-bundle-analyzer --threshold 250 --threshold 350"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/file-saver": "^2.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "pdfmake": "^0.3.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "msw": "latest",
    "pdfmake-node": "^0.2.32",
    "playwright": "^1.38.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "vitest-axe": "^0.1.0"
  }
}
